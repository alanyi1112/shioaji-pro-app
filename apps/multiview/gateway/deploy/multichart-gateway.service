[Unit]
Description=MultiChart Shioaji data-only market gateway
Documentation=https://github.com/alanyi1112/MultiChartOnCodexSite
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=multichart-gateway
Group=multichart-gateway
WorkingDirectory=/var/lib/multichart-gateway
Environment=GATEWAY_MODE=production
Environment=ACTIVE_UNIVERSE_LIMIT=32
Environment=GATEWAY_HEALTH_PORT=8788
Environment=UNSUBSCRIBE_COOLDOWN_SECONDS=30
Environment=SESSION_BUFFER_POINTS_PER_SYMBOL=18000
Environment=PROVIDER_LOGIN_ATTEMPT_LIMIT=6
Environment=PROVIDER_SUBSCRIPTION_ATTEMPT_LIMIT=64
Environment=PROVIDER_KBARS_DAILY_LIMIT=32
Environment=PROVIDER_FAILURE_THRESHOLD=3
Environment=PROVIDER_COOLDOWN_SECONDS=60
Environment=REALTIME_INGEST_URL=wss://multichart-production.alanyi1112.workers.dev/api/realtime/ingest
LoadCredentialEncrypted=shioaji_api_key:/etc/credstore.encrypted/multichart-gateway/shioaji_api_key.cred
LoadCredentialEncrypted=shioaji_secret_key:/etc/credstore.encrypted/multichart-gateway/shioaji_secret_key.cred
LoadCredentialEncrypted=cloudflare_ingest_secret:/etc/credstore.encrypted/multichart-gateway/cloudflare_ingest_secret.cred
LoadCredentialEncrypted=cloudflare_access_client_id:/etc/credstore.encrypted/multichart-gateway/cloudflare_access_client_id.cred
LoadCredentialEncrypted=cloudflare_access_client_secret:/etc/credstore.encrypted/multichart-gateway/cloudflare_access_client_secret.cred
ExecStartPre=/opt/multichart-gateway/current/.venv/bin/python -m multichart_gateway.host_preflight
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=multichart-gateway --why=market-data-runtime --mode=block /opt/multichart-gateway/current/.venv/bin/python -m multichart_gateway
Restart=on-failure
RestartSec=300
TimeoutStartSec=90
TimeoutStopSec=30
KillSignal=SIGTERM
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
StateDirectory=multichart-gateway
StateDirectoryMode=0700
RuntimeDirectory=multichart-gateway
RuntimeDirectoryMode=0700
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

usage() {
    print '使用方式：scripts/realtimestock-runtime <command>'
    print '  install               安裝並啟動 simulation 常駐服務'
    print '  uninstall             移除本工具建立的 LaunchAgent'
    print '  simulation            切回 simulation'
    print '  production-readonly   暫時切至正式行情唯讀；失敗會回復 simulation'
    print '  restart               只重啟 MultiView；不重設 5173 或 8080'
    print '  multiview-daily       手動執行本機日資料與 PE bounded pipeline'
    print '  multiview-tdcc        手動執行本機 TDCC latest／continuous bounded pipeline'
    print '  status                顯示不含秘密值的服務與行情狀態'
    print '  node-sqlite-probe     以persisted Node執行原生Apple Silicon arm64離線capability probe'
    print '  node-sqlite-host-public'
    print '                         建立／顯示本機私有attestation key的公開enrollment record'
    print '  node-sqlite-trust-host <arm-public-json> <arm-report-json>'
    print '                         明確綁定單一arm64 host key與current signed report lineage'
    print '  node-sqlite-import-report <arm64> <report-json>'
    print '                         匯入原生Apple Silicon主機的私有signed report'
    print '  smart-order-start      只安裝／啟動simulation智慧下單sidecar；不觸碰其他服務'
    print '  smart-order-task0-3c-stop'
    print '                         僅以graceful lifecycle contract停止智慧下單sidecar；不觸碰其他服務'
    print '  task0-3c-external-sell --ordinal=1|2 --run-id=... --operation-id=... --nonce=... --account-scope=sha256:... [--previous-target=...]'
    print '                         sidecar停止期間逐筆exact authorization建立外部simulation working sell'
    print '  task0-3c-authorization-preview --ordinal=1|2 --run-id=... --operation-id=... --nonce=... --account-scope=sha256:... [--previous-target=...]'
    print '                         無broker authority地預覽逐筆exact authorization字串並發出提示音'
    print '  task0-3c-finalize --run-id=... --account-scope=sha256:...'
    print '                         sidecar重啟後唯讀核對完整兩筆集合與ExternalSellClaim'
    print '  task0-3c-gate-recompute'
    print '                         sidecar內以最長360秒外部event唯讀觀察原子重算observe-only Gate manifests'
    print '  task0-3c-preflight     sidecar停止前唯讀證明position／零working sells並規劃兩個合法價位'
    print '  gate-probe-prepare <absolute-private-envelope-json>'
    print '                         互動式建立一次性simulation probe envelope；不執行broker write'
    print '  task0-3b-probe --operation=... --run-id=... --operation-id=... --nonce=... --account-scope=sha256:... [--target=...]'
    print '                         current contract／BBO逐次授權的同run place／update／cancel probe'
    print '  task0-3b-reconcile-update'
    print '                         唯讀核對已送出的固定update並建立同run下一revision；不送broker write'
    print '  task0-3b-verify-update'
    print '                         只驗證固定update與歸因；不建立revision或evidence、不送broker write'
    print '  task0-4-0-6-probe --profile=... --run-id=... --operation-id=... --nonce=... --account-scope=sha256:...'
    print '                         observer-ready後逐次授權的order／deal與LMT／MKT execution-policy probe'
    print '  task13-2-evidence      唯讀驗證並彙整固定私有正式證據矩陣；不取得broker authority'
    print '  strategy-cancel <strategy-id> <revision>'
    print '                         取消策略；有副作用時只轉 cancel_pending'
    print '  cancel-broker-order <strategy-id> <revision>'
    print '                         另行確認唯一 working BrokerOrder 的取消 intent'
    print '  drain-prepared <strategy-id> <revision>'
    print '                         本機取消已證明未送出的 prepared intent'
    print '  relinquish-protection-prepare <strategy-id> <revision>'
    print '                         第一次確認人工接手保護並建立一致性 snapshot'
    print '  relinquish-protection-commit <strategy-id> <revision> <challenge-id>'
    print '                         第二次確認並原子建立 unmonitored blocker'
    print '  （智慧下單 sidecar 僅在 simulation 以 observe-only／write disabled 啟動）'
}

run_smart_order_typed_drain_action() {
    local action="$1"
    local strategy_id="${2:-}"
    local revision="${3:-}"
    local challenge_id="${4:-}"
    local mode_state api_generation
    if [[ -z "${strategy_id}" || "${revision}" != <-> ]]; then
        print -u2 'typed drain 需要 strategy-id 與非負整數 revision'
        return 2
    fi
    preflight_persisted_smart_order_runtime_contract
    if ! job_loaded "${SMART_ORDER_LABEL}" ||
        ! strict_smart_order_discovery_epoch >/dev/null 2>&1 ||
        ! mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" ||
        [[ "${mode_state}" != 'simulation' ]] ||
        ! api_generation="$(read_private_api_generation_contract simulation 2>/dev/null)"; then
        print -u2 'typed drain 拒絕：sidecar／discovery／simulation generation 無法共同驗證'
        return 1
    fi
    if [[ "${action}" == 'relinquish-protection-commit' ]]; then
        if [[ -z "${challenge_id}" ]]; then
            print -u2 '第二次確認需要第一次回傳的 challenge-id'
            return 2
        fi
        env REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
            REALTIME_STOCK_EXPECTED_API_GENERATION="${api_generation}" \
            "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" \
            "${action}" "${strategy_id}" "${revision}" "${challenge_id}"
        return
    fi
    env REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_EXPECTED_API_GENERATION="${api_generation}" \
        "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" \
        "${action}" "${strategy_id}" "${revision}"
}

run_smart_order_gate_probe_prepare() {
    local envelope_path="${1:-}"
    local mode_state api_generation
    if [[ -z "${envelope_path}" || "${envelope_path}" != /* ]]; then
        print -u2 'gate probe envelope 必須是絕對路徑'
        return 2
    fi
    preflight_persisted_smart_order_runtime_contract
    if ! job_loaded "${SMART_ORDER_LABEL}" ||
        ! strict_smart_order_discovery_epoch >/dev/null 2>&1 ||
        ! mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" ||
        [[ "${mode_state}" != 'simulation' ]] ||
        ! api_generation="$(read_private_api_generation_contract simulation 2>/dev/null)"; then
        print -u2 'gate probe 拒絕：sidecar／discovery／simulation generation 無法共同驗證'
        return 1
    fi
    env REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_EXPECTED_API_GENERATION="${api_generation}" \
        "${NODE_BIN}" "${SMART_ORDER_GATE_PROBE_CLI}" "${envelope_path}"
}


#!/bin/zsh

set -eu

private_path_mode() {
    local value
    value="$(/usr/bin/stat -f '%Lp' "$1" 2>/dev/null || true)"
    if [[ -z "${value}" ]]; then
        value="$(/usr/bin/stat -c '%a' "$1" 2>/dev/null || true)"
    fi
    print -r -- "${value}"
}

private_path_size() {
    local value
    value="$(/usr/bin/stat -f '%z' "$1" 2>/dev/null || true)"
    if [[ -z "${value}" ]]; then
        value="$(/usr/bin/stat -c '%s' "$1" 2>/dev/null || true)"
    fi
    print -r -- "${value}"
}

current_user_private_file() {
    local file_path="$1"
    [[ -f "${file_path}" && ! -L "${file_path}" && -O "${file_path}" ]] &&
        [[ "$(private_path_mode "${file_path}")" == '600' ]]
}

current_user_private_directory() {
    local directory_path="$1"
    [[ -d "${directory_path}" && ! -L "${directory_path}" && -O "${directory_path}" ]] &&
        [[ "$(private_path_mode "${directory_path}")" == '700' ]]
}

SCRIPT_PATH="${0:A}"
SCRIPT_DIR="${SCRIPT_PATH:h}"
REPO_DIR="${REALTIME_STOCK_REPO_DIR:-${SCRIPT_DIR:h}}"
USER_ID="$(id -u)"
LAUNCH_DOMAIN="gui/${USER_ID}"

SIM_LABEL="com.alanyi.realtimestock.simulation-api"
WATCHDOG_LABEL="com.alanyi.realtimestock.business-session-watchdog"
WEB_LABEL="com.alanyi.realtimestock.web"
MULTIVIEW_LABEL="com.alanyi.realtimestock.multiview"
MULTIVIEW_DAILY_LABEL="com.alanyi.realtimestock.multiview-daily-pipeline"
MULTIVIEW_TDCC_LABEL="com.alanyi.realtimestock.multiview-tdcc-pipeline"
MULTIVIEW_TDCC_WATCHER_LABEL="com.alanyi.realtimestock.multiview-tdcc-watcher"
PROD_LABEL="com.alanyi.realtimestock.production-readonly-api"
SMART_ORDER_LABEL="com.alanyi.realtimestock.smart-order-sidecar"


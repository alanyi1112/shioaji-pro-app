    preflight_persisted_smart_order_runtime_contract
    env -i \
        PATH='/usr/bin:/bin:/usr/sbin:/sbin' \
        LANG='C' \
        LC_ALL='C' \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        "${NODE_BIN}" "${SMART_ORDER_TASK_13_2_EVIDENCE}"
}

validate_smart_order_node() {
    local candidate="$1"
    if [[ -z "${candidate}" || "${candidate}" != /* || ! -x "${candidate}" ]]; then
        print -u2 '智慧下單 Runtime 需要可執行的 Node.js 絕對路徑'
        return 1
    fi
    if ! "${candidate}" -e '
        const [major, minor, patch] = process.versions.node.split(".").map(Number);
        const supported =
            major === 24 &&
            (minor > 15 || (minor === 15 && patch >= 0)) &&
            typeof process.release.lts === "string" &&
            process.release.lts.length > 0;
        process.exit(supported ? 0 : 1);
    '; then
        print -u2 '智慧下單 Runtime 僅支援 Node.js LTS >=24.15.0 且 <25；目前 Node 不符合，保持 fail closed'
        return 1
    fi
}

assert_private_app_support_contract() {
    local canonical_repo
    canonical_repo="${REPO_DIR:A}"
    if [[ "${APP_SUPPORT}" != /* ]] ||
        ! current_user_private_directory "${APP_SUPPORT}" ||
        [[ "${APP_SUPPORT:A}" != "${APP_SUPPORT}" ]]; then
        print -u2 'REALTIME_STOCK_APP_SUPPORT 必須是 realpath、目前使用者擁有且 mode 0700 的實體目錄'
        return 1
    fi
    if [[ "${APP_SUPPORT}" == "${canonical_repo}" ||
        "${APP_SUPPORT}" == "${canonical_repo}/"* ]]; then
        print -u2 'REALTIME_STOCK_APP_SUPPORT 必須位於 RealTimeStock source repository 外'
        return 1
    fi
}

read_persisted_smart_order_node_contract() {
    local candidate resolved size
    assert_private_app_support_contract
    if ! current_user_private_file "${NODE_RUNTIME_FILE}"; then
        print -u2 'persisted Node runtime path 必須是目前使用者擁有且 mode 0600 的實體檔案'
        return 1
    fi
    size="$(private_path_size "${NODE_RUNTIME_FILE}")"
    if [[ "${size}" != <1-4096> ]]; then
        print -u2 'persisted Node runtime path 檔案大小不合法'
        return 1
    fi
    candidate="$(< "${NODE_RUNTIME_FILE}")"
    if [[ -z "${candidate}" || "${candidate}" != /* ||
        "${candidate}" == *$'\n'* || ${#candidate} -gt 4095 ]]; then
        print -u2 'persisted Node runtime path 必須是單一絕對路徑'
        return 1
    fi
    resolved="${candidate:A}"
    if [[ "${candidate}" != "${resolved}" || ! -f "${resolved}" ||
        -L "${resolved}" || ! -x "${resolved}" ]]; then
        print -u2 'persisted Node runtime path 必須是可執行檔的 canonical realpath'
        return 1
    fi
    if ! current_user_private_file "${NODE_RUNTIME_FILE}"; then
        print -u2 'persisted Node runtime path 在讀取期間失去私有權限'
        return 1
    fi
    validate_smart_order_node "${resolved}"
    print -r -- "${resolved}"
}

preflight_persisted_smart_order_runtime_contract() {
    local persisted_node
    persisted_node="$(read_persisted_smart_order_node_contract)"
    NODE_BIN="${persisted_node}"
}

read_private_runtime_mode_contract() {
    local mode
    assert_private_app_support_contract
    if ! current_user_private_file "${MODE_FILE}"; then
        return 1
    fi
    mode="$(< "${MODE_FILE}")"
    if [[ "${mode}" != 'simulation' && "${mode}" != 'production-readonly' ]]; then
        return 1
    fi
    print -r -- "${mode}"
}

read_private_api_generation_contract() {
    local expected_mode="$1"
    local generation token size
    assert_private_app_support_contract
    if ! current_user_private_file "${API_GENERATION_FILE}"; then
        return 1
    fi
    size="$(private_path_size "${API_GENERATION_FILE}")"
    if [[ "${size}" != <1-256> ]]; then
        return 1
    fi
    generation="$(< "${API_GENERATION_FILE}")"
    if [[ "${generation}" != "${expected_mode}:"* ]]; then
        return 1
    fi
    token="${generation#*:}"
    if [[ -z "${token}" || ${#token} -gt 240 ||
        "${token}" == *[^A-Za-z0-9._:-]* ]]; then
        return 1
    fi
    print -r -- "${generation}"
}

ensure_private_app_support_root() {
    local canonical_repo candidate_parent
    canonical_repo="${REPO_DIR:A}"
    candidate_parent="${APP_SUPPORT:h:A}"
    if [[ "${APP_SUPPORT}" == "${canonical_repo}" ||
        "${APP_SUPPORT}" == "${canonical_repo}/"* ||
        "${candidate_parent}" == "${canonical_repo}" ||
        "${candidate_parent}" == "${canonical_repo}/"* ]]; then
        print -u2 'REALTIME_STOCK_APP_SUPPORT 必須位於 RealTimeStock source repository 外'
        return 1
    fi
    mkdir -p "${APP_SUPPORT}"
    if [[ ! -d "${APP_SUPPORT}" || -L "${APP_SUPPORT}" || ! -O "${APP_SUPPORT}" ]]; then
        print -u2 'REALTIME_STOCK_APP_SUPPORT 必須是目前使用者擁有的實體目錄'
        return 1
    fi
    chmod 700 "${APP_SUPPORT}"
}

persist_node_runtime_contract() {
    local candidate tmp_file
    candidate="${NODE_BIN}"
    if [[ -z "${candidate}" || "${candidate}" != /* ]]; then
        print -u2 '無法解析 Node.js 的絕對路徑'
        return 1
    fi
    candidate="${candidate:A}"
    validate_smart_order_node "${candidate}"
    ensure_private_app_support_root
    umask 077
    tmp_file="${NODE_RUNTIME_FILE}.tmp.$$"
    print -r -- "${candidate}" > "${tmp_file}"
    chmod 600 "${tmp_file}"
    mv -f "${tmp_file}" "${NODE_RUNTIME_FILE}"
    NODE_BIN="${candidate}"
}

ensure_multiview_pipeline_secret() {
    mkdir -p "${MULTIVIEW_STATE_DIR}"
    chmod 700 "${MULTIVIEW_STATE_DIR}"
    if [[ ! -s "${MULTIVIEW_PIPELINE_SECRET_FILE}" ]]; then
        umask 077
        openssl rand -hex 32 > "${MULTIVIEW_PIPELINE_SECRET_FILE}"
    fi
    chmod 600 "${MULTIVIEW_PIPELINE_SECRET_FILE}"
}

read_multiview_pipeline_secret() {
    ensure_multiview_pipeline_secret
    head -n 1 "${MULTIVIEW_PIPELINE_SECRET_FILE}"
}

ensure_runtime_dependencies() {
    if [[ ! -x "${SHIOAJI_BIN}" ]]; then
        print -u2 "找不到 Shioaji CLI：${SHIOAJI_BIN}"
        return 1
    fi
    if [[ -z "${NODE_BIN}" || "${NODE_BIN}" != /* || ! -x "${NODE_BIN}" ]]; then
        print -u2 "找不到 Node.js：${NODE_BIN}"
        return 1
    fi
    if [[ ! -f "${VITE_BIN}" ]]; then
        print -u2 "找不到 Vite：${VITE_BIN}，請先在專案安裝依賴"
        return 1
    fi
    if [[ ! -f "${WATCHDOG_SCRIPT}" ]]; then
        print -u2 "找不到 business-session watchdog：${WATCHDOG_SCRIPT}"
        return 1
    fi
    if [[ ! -f "${MULTIVIEW_CLI}" || ! -x "${MULTIVIEW_STATE_SCRIPT}" ]]; then
        print -u2 '找不到 MultiView runtime，請先安裝 workspace dependency'
        return 1
    fi
    if [[ ! -f "${REPO_DIR}/.env" ]]; then
        print -u2 '找不到專案 .env；請先在本機設定 Shioaji API key 與 secret'
        return 1
    fi
}

write_mode() {
    local tmp_file
    ensure_private_app_support_root
    umask 077
    tmp_file="${MODE_FILE}.tmp.$$"
    print -r -- "$1" > "${tmp_file}"
    chmod 600 "${tmp_file}"
    mv -f "${tmp_file}" "${MODE_FILE}"
}

write_api_generation() {
    local mode="$1"
    local generation tmp_file
    validate_smart_order_node "${NODE_BIN}"
    generation="$("${NODE_BIN}" -e 'process.stdout.write(require("node:crypto").randomUUID())')"
    ensure_private_app_support_root
    umask 077
    tmp_file="${API_GENERATION_FILE}.tmp.$$"
    print -r -- "${mode}:${generation}" > "${tmp_file}"
    chmod 600 "${tmp_file}"
    mv -f "${tmp_file}" "${API_GENERATION_FILE}"
}

read_mode() {
    if [[ -r "${MODE_FILE}" ]]; then
        head -n 1 "${MODE_FILE}"
    else
        print 'unknown'
    fi
}

env_file_has_value() {
    local key="$1"
    awk -v key="${key}" '
        BEGIN { found = 0 }
        /^[[:space:]]*#/ { next }
        {
            line = $0
            sub(/^[[:space:]]*export[[:space:]]+/, "", line)
            if (line ~ ("^[[:space:]]*" key "[[:space:]]*=")) {
                sub(("^[[:space:]]*" key "[[:space:]]*=[[:space:]]*"), "", line)
                sub(/[[:space:]]*#.*$/, "", line)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
                if (line != "" && line != "\"\"" && line != "\047\047") found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    ' "${REPO_DIR}/.env"
}

assert_no_ca() {
    if env_file_has_value SJ_CA_PATH || env_file_has_value SJ_CA_PASSWD; then
        print -u2 '拒絕切換：.env 存在非空 CA 設定。正式行情唯讀不得設定 SJ_CA_PATH 或 SJ_CA_PASSWD。'
        return 1
    fi
}

smart_order_platform_supported() {
    if [[ -z "${NODE_BIN}" || "${NODE_BIN}" != /* ||
        ! -x "${NODE_BIN}" || ! -f "${SMART_ORDER_PLATFORM_SUPPORT}" ||
        -L "${SMART_ORDER_PLATFORM_SUPPORT}" ]]; then
        return 1
    fi
    "${NODE_BIN}" "${SMART_ORDER_PLATFORM_SUPPORT}" >/dev/null 2>&1
}

remove_unsupported_smart_order_launchagent_artifact() {
    if smart_order_platform_supported; then
        print -u2 '拒絕移除智慧下單 LaunchAgent：目前平台受支援'
        return 1
    fi
    if [[ "${SMART_ORDER_PLIST}" !=
        "${USER_LAUNCH_AGENTS}/com.alanyi.realtimestock.smart-order-sidecar.plist" ]]; then
        print -u2 '智慧下單 LaunchAgent 路徑不符合固定邊界；保持 fail closed'
        return 1
    fi
    if [[ -e "${SMART_ORDER_PLIST}" || -L "${SMART_ORDER_PLIST}" ]]; then
        command rm -f -- "${SMART_ORDER_PLIST}"
    fi
}

write_smart_order_plist() {
    local result
    if ! smart_order_platform_supported; then
        remove_unsupported_smart_order_launchagent_artifact
        print -u2 '智慧下單交易 Runtime 僅支援原生 Apple Silicon arm64 macOS；x64、Rosetta、VM 與其他平台保持 fail closed'
        return 1
    fi
    ensure_private_app_support_root
    mkdir -p "${USER_LAUNCH_AGENTS}"
    if [[ ! -f "${SMART_ORDER_LAUNCH_AGENT_INSTALLER}" ||
        -L "${SMART_ORDER_LAUNCH_AGENT_INSTALLER}" ]]; then
        print -u2 '智慧下單 LaunchAgent installer 不存在或不可信'
        return 1
    fi
    result="$("${NODE_BIN}" "${SMART_ORDER_LAUNCH_AGENT_INSTALLER}" \
        "${SMART_ORDER_PLIST}" "${INSTALLED_SCRIPT}" \
        "${SMART_ORDER_RUNTIME_SOURCE}" "${REPO_DIR}" "${HOME}" \
        "${APP_SUPPORT}")" || return 1
    if ! print -r -- "${result}" | jq -e '
        type == "object" and
        .schemaVersion == "smart-order-launchagent-installer/2026-08-22.3" and
        .installed == true and
        (.installedRuntimeSha256 | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        (.installedBundleSha256 | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        (.launchAgentPlistSha256 | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        .platformSupportPolicy == "smart-order-trading-runtime-platform/native-apple-silicon-arm64/2026-08-22.1" and
        .brokerAuthority == false and
        .writeMasterAuthority == false
    ' >/dev/null 2>&1; then
        print -u2 '智慧下單 LaunchAgent installer 回傳無效；保持停止'
        return 1
    fi
}

verify_smart_order_plist_binding() {
    local result
    smart_order_platform_supported || return 1
    result="$("${NODE_BIN}" "${SMART_ORDER_LAUNCH_AGENT_INSTALLER}" \
        --verify "${SMART_ORDER_PLIST}" "${INSTALLED_SCRIPT}" \
        "${SMART_ORDER_RUNTIME_SOURCE}" "${REPO_DIR}" "${HOME}" \
        "${APP_SUPPORT}")" || return 1
    if ! print -r -- "${result}" | jq -e '
        type == "object" and
        .schemaVersion == "smart-order-launchagent-installer/2026-08-22.3" and
        .verified == true and
        (.installedRuntimeSha256 | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        (.installedBundleSha256 | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        (.launchAgentPlistSha256 | type == "string" and test("^sha256:[0-9a-f]{64}$")) and
        .platformSupportPolicy == "smart-order-trading-runtime-platform/native-apple-silicon-arm64/2026-08-22.1" and
        .brokerAuthority == false and
        .writeMasterAuthority == false
    ' >/dev/null 2>&1; then
        print -u2 '智慧下單 LaunchAgent binding 無效；拒絕 bootstrap'
        return 1
    fi
}


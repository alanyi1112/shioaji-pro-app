run_smart_order_task0_3c_external_sell() {
    local mode_state api_generation api_info
    preflight_persisted_smart_order_runtime_contract
    if job_loaded "${SMART_ORDER_LABEL}" ||
        [[ -e "${SMART_ORDER_DISCOVERY_PATH}" || -L "${SMART_ORDER_DISCOVERY_PATH}" ]] ||
        [[ -e "${SMART_ORDER_LIFECYCLE_STOP_BARRIER_PATH}" || -L "${SMART_ORDER_LIFECYCLE_STOP_BARRIER_PATH}" ]] ||
        ! mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" ||
        [[ "${mode_state}" != 'simulation' ]] ||
        ! api_generation="$(read_private_api_generation_contract simulation 2>/dev/null)"; then
        print -u2 'Task 0.3c external sender拒絕：sidecar未完整停止或simulation generation無法驗證'
        return 1
    fi
    api_info="$(curl -fsS --max-time 3 http://127.0.0.1:8080/api/v1/info 2>/dev/null || true)"
    if ! print -r -- "${api_info}" | jq -e '.simulation == true' >/dev/null 2>&1; then
        print -u2 'Task 0.3c external sender拒絕：simulation API listener不可用或模式不符'
        return 1
    fi
    env REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_EXPECTED_API_GENERATION="${api_generation}" \
        "${NODE_BIN}" "${SMART_ORDER_TASK_0_3C_EXTERNAL_SELL}" "$@"
}


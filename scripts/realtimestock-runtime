#!/bin/zsh

set -eu

SCRIPT_PATH="${0:A}"
SCRIPT_DIR="${SCRIPT_PATH:h}"
REPO_DIR="${REALTIME_STOCK_REPO_DIR:-${SCRIPT_DIR:h}}"
USER_ID="$(id -u)"
LAUNCH_DOMAIN="gui/${USER_ID}"

SIM_LABEL="com.alanyi.realtimestock.simulation-api"
WEB_LABEL="com.alanyi.realtimestock.web"
MULTIVIEW_LABEL="com.alanyi.realtimestock.multiview"
MULTIVIEW_DAILY_LABEL="com.alanyi.realtimestock.multiview-daily-pipeline"
MULTIVIEW_TDCC_LABEL="com.alanyi.realtimestock.multiview-tdcc-pipeline"
PROD_LABEL="com.alanyi.realtimestock.production-readonly-api"

APP_SUPPORT="${REALTIME_STOCK_APP_SUPPORT:-${HOME}/Library/Application Support/RealTimeStock}"
INSTALLED_BIN_DIR="${APP_SUPPORT}/bin"
INSTALLED_SCRIPT="${INSTALLED_BIN_DIR}/realtimestock-runtime"
GENERATED_DIR="${APP_SUPPORT}/LaunchAgents"
USER_LAUNCH_AGENTS="${HOME}/Library/LaunchAgents"
MODE_FILE="${APP_SUPPORT}/runtime-mode"
SIM_PLIST="${USER_LAUNCH_AGENTS}/${SIM_LABEL}.plist"
WEB_PLIST="${USER_LAUNCH_AGENTS}/${WEB_LABEL}.plist"
MULTIVIEW_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_LABEL}.plist"
MULTIVIEW_DAILY_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_DAILY_LABEL}.plist"
MULTIVIEW_TDCC_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_TDCC_LABEL}.plist"
PROD_PLIST="${GENERATED_DIR}/${PROD_LABEL}.plist"

SHIOAJI_BIN="${REALTIME_STOCK_SHIOAJI_BIN:-${HOME}/.local/bin/shioaji}"
NODE_BIN="/opt/homebrew/bin/node"
VITE_BIN="${REPO_DIR}/node_modules/vite/bin/vite.js"
MULTIVIEW_CLI="${REPO_DIR}/apps/multiview/node_modules/vinext/dist/cli.js"
MULTIVIEW_STATE_SCRIPT="${REPO_DIR}/scripts/multiview-state"
MULTIVIEW_STATE_DIR="${REALTIME_STOCK_MULTIVIEW_STATE_DIR:-${APP_SUPPORT}/MultiView}"
MULTIVIEW_PIPELINE_SECRET_FILE="${MULTIVIEW_STATE_DIR}/pipeline-secret"

usage() {
    print '使用方式：scripts/realtimestock-runtime <command>'
    print '  install               安裝並啟動 simulation 常駐服務'
    print '  uninstall             移除本工具建立的 LaunchAgent'
    print '  simulation            切回 simulation'
    print '  production-readonly   暫時切至正式行情唯讀；失敗會回復 simulation'
    print '  restart               只重啟 MultiView；不重設 5173 或 8080'
    print '  multiview-daily       手動執行本機日資料與 PE bounded pipeline'
    print '  multiview-tdcc        手動執行本機 TDCC latest／continuous bounded pipeline'
    print '  status                顯示不含秘密值的服務與行情狀態'
}

ensure_multiview_pipeline_secret() {
    mkdir -p "${MULTIVIEW_STATE_DIR}"
    chmod 700 "${MULTIVIEW_STATE_DIR}"
    if [[ ! -s "${MULTIVIEW_PIPELINE_SECRET_FILE}" ]]; then
        umask 077
        openssl rand -hex 32 > "${MULTIVIEW_PIPELINE_SECRET_FILE}"
    fi
    chmod 600 "${MULTIVIEW_PIPELINE_SECRET_FILE}"
}

read_multiview_pipeline_secret() {
    ensure_multiview_pipeline_secret
    head -n 1 "${MULTIVIEW_PIPELINE_SECRET_FILE}"
}

ensure_runtime_dependencies() {
    if [[ ! -x "${SHIOAJI_BIN}" ]]; then
        print -u2 "找不到 Shioaji CLI：${SHIOAJI_BIN}"
        return 1
    fi
    if [[ ! -x "${NODE_BIN}" ]]; then
        print -u2 "找不到 Node.js：${NODE_BIN}"
        return 1
    fi
    if [[ ! -f "${VITE_BIN}" ]]; then
        print -u2 "找不到 Vite：${VITE_BIN}，請先在專案安裝依賴"
        return 1
    fi
    if [[ ! -f "${MULTIVIEW_CLI}" || ! -x "${MULTIVIEW_STATE_SCRIPT}" ]]; then
        print -u2 '找不到 MultiView runtime，請先安裝 workspace dependency'
        return 1
    fi
    if [[ ! -f "${REPO_DIR}/.env" ]]; then
        print -u2 '找不到專案 .env；請先在本機設定 Shioaji API key 與 secret'
        return 1
    fi
}

write_mode() {
    mkdir -p "${APP_SUPPORT}"
    umask 077
    print -r -- "$1" > "${MODE_FILE}"
}

read_mode() {
    if [[ -r "${MODE_FILE}" ]]; then
        head -n 1 "${MODE_FILE}"
    else
        print 'unknown'
    fi
}

env_file_has_value() {
    local key="$1"
    awk -v key="${key}" '
        BEGIN { found = 0 }
        /^[[:space:]]*#/ { next }
        {
            line = $0
            sub(/^[[:space:]]*export[[:space:]]+/, "", line)
            if (line ~ ("^[[:space:]]*" key "[[:space:]]*=")) {
                sub(("^[[:space:]]*" key "[[:space:]]*=[[:space:]]*"), "", line)
                sub(/[[:space:]]*#.*$/, "", line)
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
                if (line != "" && line != "\"\"" && line != "\047\047") found = 1
            }
        }
        END { exit(found ? 0 : 1) }
    ' "${REPO_DIR}/.env"
}

assert_no_ca() {
    if env_file_has_value SJ_CA_PATH || env_file_has_value SJ_CA_PASSWD; then
        print -u2 '拒絕切換：.env 存在非空 CA 設定。正式行情唯讀不得設定 SJ_CA_PATH 或 SJ_CA_PASSWD。'
        return 1
    fi
}

write_plists() {
    mkdir -p "${APP_SUPPORT}" "${GENERATED_DIR}" "${USER_LAUNCH_AGENTS}"
    umask 077

    cat > "${SIM_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${SIM_LABEL}</string>
<key>ProgramArguments</key><array><string>${INSTALLED_SCRIPT}</string><string>service-api-simulation</string></array>
<key>WorkingDirectory</key><string>${REPO_DIR}</string>
<key>EnvironmentVariables</key><dict>
<key>HOME</key><string>${HOME}</string>
<key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin</string>
<key>REALTIME_STOCK_REPO_DIR</key><string>${REPO_DIR}</string>
</dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>/dev/null</string>
<key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
EOF

    cat > "${WEB_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${WEB_LABEL}</string>
<key>ProgramArguments</key><array><string>${INSTALLED_SCRIPT}</string><string>service-web</string></array>
<key>WorkingDirectory</key><string>${REPO_DIR}</string>
<key>EnvironmentVariables</key><dict>
<key>HOME</key><string>${HOME}</string>
<key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin</string>
<key>REALTIME_STOCK_REPO_DIR</key><string>${REPO_DIR}</string>
</dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>/dev/null</string>
<key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
EOF

    cat > "${MULTIVIEW_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${MULTIVIEW_LABEL}</string>
<key>ProgramArguments</key><array><string>${INSTALLED_SCRIPT}</string><string>service-multiview</string></array>
<key>WorkingDirectory</key><string>${REPO_DIR}/apps/multiview</string>
<key>EnvironmentVariables</key><dict>
<key>HOME</key><string>${HOME}</string>
<key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
<key>REALTIME_STOCK_REPO_DIR</key><string>${REPO_DIR}</string>
<key>MULTIVIEW_STATE_DIR</key><string>${MULTIVIEW_STATE_DIR}</string>
</dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>
<key>StandardOutPath</key><string>/dev/null</string>
<key>StandardErrorPath</key><string>/dev/null</string>
</dict></plist>
EOF

    cat > "${MULTIVIEW_DAILY_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${MULTIVIEW_DAILY_LABEL}</string>
<key>ProgramArguments</key><array><string>${INSTALLED_SCRIPT}</string><string>service-multiview-daily-pipeline</string></array>
<key>WorkingDirectory</key><string>${REPO_DIR}/apps/multiview</string>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>${HOME}</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>REALTIME_STOCK_REPO_DIR</key><string>${REPO_DIR}</string></dict>
<key>RunAtLoad</key><true/>
<key>StartCalendarInterval</key><array>
<dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
<dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
<dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
<dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
<dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer></dict>
</array>
<key>StandardOutPath</key><string>${MULTIVIEW_STATE_DIR}/logs/daily-pipeline.log</string>
<key>StandardErrorPath</key><string>${MULTIVIEW_STATE_DIR}/logs/daily-pipeline.log</string>
</dict></plist>
EOF

    cat > "${MULTIVIEW_TDCC_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${MULTIVIEW_TDCC_LABEL}</string>
<key>ProgramArguments</key><array><string>${INSTALLED_SCRIPT}</string><string>service-multiview-tdcc-pipeline</string></array>
<key>WorkingDirectory</key><string>${REPO_DIR}/apps/multiview</string>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>${HOME}</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string><key>REALTIME_STOCK_REPO_DIR</key><string>${REPO_DIR}</string></dict>
<key>RunAtLoad</key><true/>
<key>StartCalendarInterval</key><dict><key>Weekday</key><integer>7</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
<key>StandardOutPath</key><string>${MULTIVIEW_STATE_DIR}/logs/tdcc-pipeline.log</string>
<key>StandardErrorPath</key><string>${MULTIVIEW_STATE_DIR}/logs/tdcc-pipeline.log</string>
</dict></plist>
EOF

    cat > "${PROD_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>${PROD_LABEL}</string>
<key>ProgramArguments</key><array><string>${INSTALLED_SCRIPT}</string><string>service-api-production-readonly</string></array>
<key>WorkingDirectory</key><string>${REPO_DIR}</string>
<key>EnvironmentVariables</key><dict>
<key>HOME</key><string>${HOME}</string>
<key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${HOME}/.local/bin</string>
<key>REALTIME_STOCK_REPO_DIR</key><string>${REPO_DIR}</string>
</dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>10</integer>

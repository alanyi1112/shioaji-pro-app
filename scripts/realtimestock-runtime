API_GENERATION_FILE="${APP_SUPPORT}/runtime-api-generation"
SIM_PLIST="${USER_LAUNCH_AGENTS}/${SIM_LABEL}.plist"
WATCHDOG_PLIST="${USER_LAUNCH_AGENTS}/${WATCHDOG_LABEL}.plist"
WEB_PLIST="${USER_LAUNCH_AGENTS}/${WEB_LABEL}.plist"
MULTIVIEW_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_LABEL}.plist"
MULTIVIEW_DAILY_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_DAILY_LABEL}.plist"
MULTIVIEW_TDCC_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_TDCC_LABEL}.plist"
MULTIVIEW_TDCC_WATCHER_PLIST="${USER_LAUNCH_AGENTS}/${MULTIVIEW_TDCC_WATCHER_LABEL}.plist"
PROD_PLIST="${GENERATED_DIR}/${PROD_LABEL}.plist"
SMART_ORDER_PLIST="${USER_LAUNCH_AGENTS}/${SMART_ORDER_LABEL}.plist"

SHIOAJI_BIN="${REALTIME_STOCK_SHIOAJI_BIN:-${HOME}/.local/bin/shioaji}"
NODE_BIN="${REALTIME_STOCK_NODE_BIN:-}"
if [[ -z "${NODE_BIN}" ]] && current_user_private_file "${NODE_RUNTIME_FILE}"; then

if [[ -n "${NODE_BIN}" && "${NODE_BIN}" == /* ]]; then
    NODE_BIN="${NODE_BIN:A}"
fi
APP_NODE_BIN="${REALTIME_STOCK_APP_NODE_BIN:-}"
if [[ -z "${APP_NODE_BIN}" ]]; then
    APP_NODE_BIN="$(command -v node 2>/dev/null || true)"
fi
if [[ -n "${APP_NODE_BIN}" && "${APP_NODE_BIN}" == /* ]]; then
    APP_NODE_BIN="${APP_NODE_BIN:A}"
fi
VITE_BIN="${REPO_DIR}/node_modules/vite/bin/vite.js"
MULTIVIEW_CLI="${REPO_DIR}/apps/multiview/node_modules/vinext/dist/cli.js"
MULTIVIEW_STATE_SCRIPT="${REPO_DIR}/scripts/multiview-state"
WATCHDOG_SCRIPT="${REPO_DIR}/scripts/realtimestock-watchdog.mjs"
WATCHDOG_STATE_DIR="${REALTIME_STOCK_WATCHDOG_STATE_DIR:-${APP_SUPPORT}/watchdog}"
MULTIVIEW_STATE_DIR="${REALTIME_STOCK_MULTIVIEW_STATE_DIR:-${APP_SUPPORT}/MultiView}"
MULTIVIEW_PIPELINE_SECRET_FILE="${MULTIVIEW_STATE_DIR}/pipeline-secret"
SMART_ORDER_ENTRY="${REPO_DIR}/scripts/smart-order-runtime/sidecar-entry.mjs"
SMART_ORDER_NODE_SQLITE_PROBE="${REPO_DIR}/scripts/smart-order-node-sqlite-capability-launcher.mjs"

}

job_loaded() {
    launchctl print "${LAUNCH_DOMAIN}/$1" >/dev/null 2>&1
}

job_pid() {
    local value
    value="$(launchctl print "${LAUNCH_DOMAIN}/$1" 2>/dev/null |
        awk '/^[[:space:]]*pid = / {print $3; exit}')"
    [[ "${value}" == <1-> ]] || return 1
    print -r -- "${value}"
}

bootout_job() {
    local label="$1"
    if job_loaded "${label}"; then
        launchctl bootout "${LAUNCH_DOMAIN}/${label}" >/dev/null
    fi
}

bootstrap_job() {
    local label="$1"
    local plist="$2"
    if ! job_loaded "${label}"; then
        launchctl bootstrap "${LAUNCH_DOMAIN}" "${plist}"
    fi
}

strict_smart_order_discovery_epoch() {
    local minimum_started_at_epoch_ms="${1:-0}"
    local now_epoch_ms file_size
    [[ "${minimum_started_at_epoch_ms}" == <0-> ]] || return 1
    assert_private_app_support_contract >/dev/null 2>&1 || return 1
    current_user_private_directory "${SMART_ORDER_ROOT}" || return 1
    current_user_private_directory "${SMART_ORDER_ROOT}/run" || return 1
    current_user_private_file "${SMART_ORDER_DISCOVERY_PATH}" || return 1
    file_size="$(private_path_size "${SMART_ORDER_DISCOVERY_PATH}")"
    [[ "${file_size}" == <1-1024> ]] || return 1
    now_epoch_ms="$(($(date +%s) * 1000))"
    jq -er \
        --arg expected_schema 'smart-order-local-sidecar/2026-08-11.1' \
        --argjson minimum_started_at_epoch_ms "${minimum_started_at_epoch_ms}" \
        --argjson now_epoch_ms "${now_epoch_ms}" '
            if type == "object" and
                (keys | sort) == ([
                    "host",
                    "port",
                    "runtimeEpochId",
                    "schemaVersion",
                    "startedAtEpochMs"
                ] | sort) and
                .schemaVersion == $expected_schema and
                .host == "127.0.0.1" and
                (.port | type == "number" and floor == . and . >= 1 and . <= 65535) and
                (.runtimeEpochId | type == "string" and test("^[A-Za-z0-9._:-]{1,240}$")) and
                (.startedAtEpochMs | type == "number" and floor == . and
                    . >= $minimum_started_at_epoch_ms and
                    . <= ($now_epoch_ms + 30000))
            then .runtimeEpochId
            else error("invalid smart-order discovery")
            end
        ' "${SMART_ORDER_DISCOVERY_PATH}" 2>/dev/null
}

smart_order_sidecar_status() {
    local job_state='stopped'
    local discovery_state='absent'
    local repository_state='not-created'
    local generation_state='absent'
    local health_state='unverified'
    local readiness_state='not-ready'
    local obligation_state='0'
    local reconciliation_state='required-before-any-write'
    local blocker_state='unknown'
    local remainder_state='unknown'
    local remainder_max_shares='unknown'
    local drain_items='unavailable'
    local drain_records='unavailable'
    local mode_state api_generation diagnostics
    if job_loaded "${SMART_ORDER_LABEL}"; then
        job_state='loaded'
    fi
    if [[ -e "${SMART_ORDER_DISCOVERY_PATH}" || -L "${SMART_ORDER_DISCOVERY_PATH}" ]]; then
        if strict_smart_order_discovery_epoch >/dev/null; then
            discovery_state='valid-private'
        else
            discovery_state='unsafe-or-invalid'
        fi
    fi
    if [[ -e "${SMART_ORDER_ROOT}" || -L "${SMART_ORDER_ROOT}" ]]; then
        if ! current_user_private_directory "${SMART_ORDER_ROOT}"; then
            repository_state='unsafe-path'
            obligation_state='unknown'
        elif [[ -e "${SMART_ORDER_DATABASE_PATH}" || -L "${SMART_ORDER_DATABASE_PATH}" ]]; then
            if current_user_private_directory "${SMART_ORDER_ROOT}/database" &&
                current_user_private_file "${SMART_ORDER_DATABASE_PATH}" &&
                { [[ ! -e "${SMART_ORDER_DATABASE_PATH}-wal" && ! -L "${SMART_ORDER_DATABASE_PATH}-wal" ]] ||
                    current_user_private_file "${SMART_ORDER_DATABASE_PATH}-wal"; } &&
                { [[ ! -e "${SMART_ORDER_DATABASE_PATH}-shm" && ! -L "${SMART_ORDER_DATABASE_PATH}-shm" ]] ||
                    current_user_private_file "${SMART_ORDER_DATABASE_PATH}-shm"; }; then
                repository_state='private-present'
            else
                repository_state='unsafe-path'
            fi
            obligation_state='unknown'
        fi
    fi
    if mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" &&
        api_generation="$(read_private_api_generation_contract "${mode_state}" 2>/dev/null)"; then
        generation_state='valid-private'
    elif [[ -e "${API_GENERATION_FILE}" || -L "${API_GENERATION_FILE}" ||
        -e "${MODE_FILE}" || -L "${MODE_FILE}" ]]; then
        generation_state='unsafe-or-invalid'
    fi
    if [[ "${job_state}" == 'loaded' && "${mode_state:-unknown}" == 'simulation' &&
        "${discovery_state}" == 'valid-private' &&
        "${generation_state}" == 'valid-private' &&
        -f "${SMART_ORDER_DIAGNOSTICS}" && -x "${NODE_BIN}" ]]; then
        diagnostics="$(env \
            REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
            REALTIME_STOCK_EXPECTED_API_GENERATION="${api_generation}" \
            "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" status 2>/dev/null || true)"
        if print -r -- "${diagnostics}" | jq -e '
            type == "object" and
            .schemaVersion == "smart-order-runtime-diagnostics/2026-08-12.2" and
            .authenticated == true and
            .dispatchAllowed == false and
            .writeMaster == "disabled" and
            .accountIdentifiersExposed == false and
            .entityIdentifiersExposed == false and
            .secretValuesExposed == false and
            (.activeObligationCount | type == "number" and floor == . and . >= 0) and
            (.blockerCount | type == "number" and floor == . and . >= 0) and
            (.runtimeTrackedUnprotectedRemainder.state == "known" or
             .runtimeTrackedUnprotectedRemainder.state == "unknown") and
            (.drainItems | type == "array" and length <= 16 and
                all(type == "object" and
                    (.kind | type == "string") and
                    (.count | type == "number" and floor == . and . >= 0) and
                    (.disposition | type == "string"))) and
            (.drainRecordsTruncated | type == "boolean") and
            (.drainRecords | type == "array" and length <= 100 and
                to_entries | all(
                    (.value | type == "object") and
                    ((.value | keys | sort) == [
                        "disposition", "kind", "ordinal", "quantityShares",
                        "quantityState", "state"
                    ]) and
                    (.value.ordinal == (.key + 1)) and
                    (.value.kind | type == "string") and
                    (.value.state | type == "string") and
                    (.value.disposition | type == "string") and
                    (.value.quantityState == "not_applicable" or
                     .value.quantityState == "exact" or
                     .value.quantityState == "conservative_maximum") and
                    (if .value.quantityState == "not_applicable"
                     then .value.quantityShares == null
                     else (.value.quantityShares | type == "number" and
                           floor == . and . >= 0)
                     end)))
        ' >/dev/null 2>&1; then
            health_state='authenticated'
            obligation_state="$(print -r -- "${diagnostics}" | jq -r '.activeObligationCount')"
            repository_state="$(print -r -- "${diagnostics}" | jq -r 'if .repositoryReady then "private-verified" else "private-unready" end')"
            readiness_state='not-ready'
            reconciliation_state="$(print -r -- "${diagnostics}" | jq -r '.reconciliation')"
            blocker_state="$(print -r -- "${diagnostics}" | jq -r '.blockerCount')"
            remainder_state="$(print -r -- "${diagnostics}" | jq -r '.runtimeTrackedUnprotectedRemainder.state')"
            remainder_max_shares="$(print -r -- "${diagnostics}" | jq -r '.runtimeTrackedUnprotectedRemainder.conservativeMaximumShares')"
            drain_items="$(print -r -- "${diagnostics}" | jq -c '[.drainItems[] | select(.count > 0) | {kind, count, disposition}]')"
            drain_records="$(print -r -- "${diagnostics}" | jq -c '[.drainRecords[] | {ordinal, kind, state, quantityShares, quantityState, disposition}]')"
        fi
    fi
    print "smart_order_sidecar_job=${job_state}"
    print "smart_order_sidecar_health=${health_state}"
    print "smart_order_sidecar_discovery=${discovery_state}"
    print "smart_order_sidecar_readiness=${readiness_state}"
    print "smart_order_mode_generation=${generation_state}"
    print "smart_order_repository=${repository_state}"
    print "smart_order_reconciliation=${reconciliation_state}"
    print "smart_order_lifecycle_blockers=${blocker_state}"
    print "smart_order_unprotected_remainder_state=${remainder_state}"
    print "smart_order_unprotected_remainder_max_shares=${remainder_max_shares}"
    print "smart_order_active_obligations=${obligation_state}"
    print "smart_order_drain_items=${drain_items}"
    print "smart_order_drain_records=${drain_records}"
    print 'smart_order_write_master=disabled'
}

wait_smart_order_sidecar_started() {
    local minimum_started_at_epoch_ms="$1"
    local expected_api_generation="$2"
    local expected_api_pid="$3"
    local attempt current_api_generation current_api_pid diagnostics
    local discovery_port runtime_epoch sidecar_pid sidecar_pid_after
    for attempt in {1..15}; do
        if job_loaded "${SIM_LABEL}" &&
            current_api_pid="$(job_pid "${SIM_LABEL}" 2>/dev/null)" &&
            [[ "${current_api_pid}" == "${expected_api_pid}" ]] &&
            current_api_generation="$(read_private_api_generation_contract simulation 2>/dev/null)" &&
            [[ "${current_api_generation}" == "${expected_api_generation}" ]] &&
            sidecar_pid="$(job_pid "${SMART_ORDER_LABEL}" 2>/dev/null)" &&
            runtime_epoch="$(strict_smart_order_discovery_epoch "${minimum_started_at_epoch_ms}" 2>/dev/null)" &&
            discovery_port="$(jq -er '.port' "${SMART_ORDER_DISCOVERY_PATH}" 2>/dev/null)" &&
            lsof -nP -a -p "${sidecar_pid}" -iTCP:"${discovery_port}" -sTCP:LISTEN >/dev/null 2>&1; then
            diagnostics="$(env \
                REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
                REALTIME_STOCK_EXPECTED_API_GENERATION="${expected_api_generation}" \
                "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" status 2>/dev/null || true)"
            sidecar_pid_after="$(job_pid "${SMART_ORDER_LABEL}" 2>/dev/null || true)"
            if [[ "${sidecar_pid_after}" == "${sidecar_pid}" ]] &&
                [[ "$(job_pid "${SIM_LABEL}" 2>/dev/null || true)" == "${expected_api_pid}" ]] &&
                [[ "$(read_private_api_generation_contract simulation 2>/dev/null || true)" == "${expected_api_generation}" ]] &&
                [[ "$(strict_smart_order_discovery_epoch "${minimum_started_at_epoch_ms}" 2>/dev/null || true)" == "${runtime_epoch}" ]] &&
                print -r -- "${diagnostics}" | jq -e '
                    type == "object" and
                    .schemaVersion == "smart-order-runtime-diagnostics/2026-08-12.2" and
                    .authenticated == true and
                    .dispatchAllowed == false and
                    .writeMaster == "disabled" and
                    .accountIdentifiersExposed == false and
                    .entityIdentifiersExposed == false and
                    .secretValuesExposed == false
                ' >/dev/null 2>&1; then
                return 0
            fi
        fi
        sleep 1
    done
    print -u2 '智慧下單 sidecar 未能在 15 秒內建立私有 loopback discovery；broker write 仍封鎖'
    return 1
}

start_smart_order_sidecar() {
    local mode_state api_generation api_pid minimum_started_at_epoch_ms
    if ! smart_order_platform_supported; then
        print -u2 '智慧下單 sidecar 拒絕啟動：僅支援原生 Apple Silicon arm64 macOS；未取得 broker authority'
        return 1
    fi
    preflight_persisted_smart_order_runtime_contract
    if ! mode_state="$(read_private_runtime_mode_contract)" ||
        [[ "${mode_state}" != 'simulation' ]] ||
        ! api_generation="$(read_private_api_generation_contract simulation)" ||
        ! api_pid="$(job_pid "${SIM_LABEL}")"; then
        print -u2 '智慧下單 sidecar 僅允許在 simulation 啟動'
        return 1
    fi
    if [[ ! -f "${SMART_ORDER_ENTRY}" ]]; then
        print -u2 '找不到智慧下單 sidecar entry；broker write 仍封鎖'
        return 1
    fi
    if [[ ! -f "${API_GENERATION_FILE}" ]]; then
        print -u2 '缺少私有 API generation marker；智慧下單 sidecar 保持停止'
        return 1
    fi
    if job_loaded "${SMART_ORDER_LABEL}"; then
        print -u2 '智慧下單 sidecar 已載入；拒絕以 start 入口重啟'
        return 1
    fi
    minimum_started_at_epoch_ms="$("${NODE_BIN}" -e 'process.stdout.write(String(Date.now()))')"
    if [[ "$(job_pid "${SIM_LABEL}" 2>/dev/null || true)" != "${api_pid}" ]] ||
        [[ "$(read_private_api_generation_contract simulation 2>/dev/null || true)" != "${api_generation}" ]]; then
        print -u2 '智慧下單 sidecar 啟動前 API PID／generation 已漂移'
        return 1
    fi
    if ! verify_smart_order_plist_binding; then
        print -u2 '智慧下單 sidecar 啟動前 installed runtime／plist binding 已漂移'
        return 1
    fi
    launchctl bootstrap "${LAUNCH_DOMAIN}" "${SMART_ORDER_PLIST}"
    if ! wait_smart_order_sidecar_started \
        "${minimum_started_at_epoch_ms}" "${api_generation}" "${api_pid}"; then
        return 1
    fi
    verify_smart_order_plist_binding
}

start_smart_order_sidecar_only() {
    local mode_state
    preflight_persisted_smart_order_runtime_contract
    if job_loaded "${SMART_ORDER_LABEL}"; then
        print -u2 '智慧下單 sidecar 已載入；拒絕以 sidecar-only 入口重啟'
        return 1
    fi
    if ! job_loaded "${SIM_LABEL}"; then
        print -u2 '智慧下單 sidecar-only 啟動要求現有 managed simulation API；不會代為啟動或重啟'
        return 1
    fi
    if ! mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" ||
        [[ "${mode_state}" != 'simulation' ]]; then
        print -u2 '智慧下單 sidecar-only 啟動要求 current simulation mode marker'
        return 1
    fi
    if ! read_private_api_generation_contract simulation >/dev/null 2>&1; then
        print -u2 '智慧下單 sidecar-only 啟動缺少 current simulation API generation；不得事後補造或重啟 API'
        return 1
    fi
    write_smart_order_plist
    start_smart_order_sidecar
}

quiesce_smart_order_sidecar_for_lifecycle() {
    local operation="$1"
    local mode_state api_generation result
    if [[ ! -e "${SMART_ORDER_ROOT}" && ! -L "${SMART_ORDER_ROOT}" &&
        ! -e "${SMART_ORDER_DISCOVERY_PATH}" && ! -L "${SMART_ORDER_DISCOVERY_PATH}" ]] &&
        ! job_loaded "${SMART_ORDER_LABEL}"; then
        return 0
    fi
    preflight_persisted_smart_order_runtime_contract
    if ! job_loaded "${SMART_ORDER_LABEL}" ||
        ! strict_smart_order_discovery_epoch >/dev/null 2>&1 ||
        ! mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" ||
        [[ "${mode_state}" != 'simulation' ]] ||
        ! api_generation="$(read_private_api_generation_contract simulation 2>/dev/null)"; then
        print -u2 '拒絕生命週期操作：智慧單 sidecar／私有 discovery／simulation generation 無法共同驗證；本次未停止任何服務。'
        return 1
    fi
    result="$(env \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_EXPECTED_API_GENERATION="${api_generation}" \
        "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" quiesce "${operation}" \
        2>/dev/null)" || {
        print -u2 '拒絕生命週期操作：無法取得 authenticated durable quiesce 結果；本次未停止任何服務。'
        return 1
    }
    if ! print -r -- "${result}" | jq -e \
        --arg operation "${operation}" '
            type == "object" and
            .schemaVersion == "smart-order-runtime-quiesce-result/2026-08-12.1" and
            .operation == $operation and
            .state == "quiescing" and
            .drainAllowed == true and
            .dispatchAllowed == false and
            .writeMaster == "disabled" and
            (.blockerCount | type == "number" and floor == . and . == 0) and
            .accountIdentifiersExposed == false and
            .entityIdentifiersExposed == false and
            .secretValuesExposed == false
        ' >/dev/null 2>&1; then
        print -u2 '拒絕生命週期操作：智慧單仍有未完成 strategy／intent／order／reservation／claim／obligation 或對帳義務；sidecar 已維持 observe-only／reconciling 且未停止其他服務。'
        return 1
    fi
}

stop_smart_order_sidecar_for_lifecycle() {
    local operation="${1:-}"
    local result completion_binding finalized
    case "${operation}" in
        graceful_stop|production_readonly|uninstall) ;;
        *)
            print -u2 '拒絕停止智慧下單 sidecar：生命週期 operation 未明確指定或不受此路徑支援'
            return 1
            ;;
    esac
    if [[ ! -e "${SMART_ORDER_ROOT}" && ! -L "${SMART_ORDER_ROOT}" &&
        ! -e "${SMART_ORDER_DISCOVERY_PATH}" && ! -L "${SMART_ORDER_DISCOVERY_PATH}" ]] &&
        ! job_loaded "${SMART_ORDER_LABEL}"; then
        return 0
    fi
    # Recover the exact post-completion crash window.  Both the
    # HMAC completion and its matching barrier must exist, discovery must be
    # gone, and the completion itself proves listener/repository/lease release.
    # The old launchd job may still be loaded if the client lost the response
    # or crashed before bootout; only after verification may we unload it.
    # A lone barrier remains fail closed and is never guessed complete.
    if [[ ! -e "${SMART_ORDER_DISCOVERY_PATH}" && ! -L "${SMART_ORDER_DISCOVERY_PATH}" &&
        -e "${SMART_ORDER_LIFECYCLE_STOP_COMPLETION_PATH}" &&
        -e "${SMART_ORDER_LIFECYCLE_STOP_BARRIER_PATH}" ]]; then
        result="$(env \
            REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
            "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" pending-stop \
            2>/dev/null)" || {
            print -u2 '拒絕恢復生命週期操作：pending stop completion 無法驗證；handoff barrier 保留。'
            return 1
        }
        if ! print -r -- "${result}" | jq -e \
            --arg operation "${operation}" '
                type == "object" and
                .schemaVersion == "smart-order-runtime-stop-pending/2026-08-12.1" and
                .operation == $operation and
                (.stopRevision | type == "number" and floor == . and . >= 0) and
                .repositoryClosed == true and
                .controlPlaneUnpublished == true and
                .runtimeLeaseReleased == true and
                .dispatchAllowed == false and
                .writeMaster == "disabled" and
                .brokerWriteAttempted == false and
                .secretValuesExposed == false
            ' >/dev/null 2>&1; then
            print -u2 '拒絕恢復生命週期操作：pending completion 與 operation 不一致；handoff barrier 保留。'
            return 1
        fi
        completion_binding="$(print -r -- "${result}" | jq -c '.completionBinding')"
        if job_loaded "${SMART_ORDER_LABEL}"; then
            bootout_job "${SMART_ORDER_LABEL}"
            if job_loaded "${SMART_ORDER_LABEL}"; then
                print -u2 'pending completion 已驗證，但 sidecar job 尚未卸載；handoff barrier 保留。'
                return 1
            fi
        fi
        finalized="$(env \
            REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
            REALTIME_STOCK_LIFECYCLE_STOP_BINDING="${completion_binding}" \
            "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" finalize-stop \
            2>/dev/null)" || {
            print -u2 'pending stop completion 未能 single-consume；handoff barrier 保留。'
            return 1
        }
        if ! print -r -- "${finalized}" | jq -e \
            --arg operation "${operation}" '
                type == "object" and
                .schemaVersion == "smart-order-runtime-stop-finalized/2026-08-12.1" and
                .operation == $operation and
                (.stopRevision | type == "number" and floor == . and . >= 0) and
                .finalized == true and
                .dispatchAllowed == false and
                .writeMaster == "disabled" and
                .brokerWriteAttempted == false and
                .secretValuesExposed == false
            ' >/dev/null 2>&1; then
            print -u2 'pending stop finalize projection 無效；handoff barrier 保留。'
            return 1
        fi
        return 0
    fi
    quiesce_smart_order_sidecar_for_lifecycle "${operation}"
    result="$(env \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_EXPECTED_API_GENERATION="$(read_private_api_generation_contract simulation)" \
        "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" stop "${operation}" \
        2>/dev/null)" || {
        print -u2 '拒絕生命週期操作：sidecar 未產生 exact durable stop completion；本次不執行 bootout。'
        return 1
    }
    if ! print -r -- "${result}" | jq -e \
        --arg operation "${operation}" '
            type == "object" and
            .schemaVersion == "smart-order-runtime-stop-result/2026-08-12.1" and
            .operation == $operation and
            .state == "closed" and
            (.stopRevision | type == "number" and floor == . and . >= 0) and
            .repositoryClosed == true and
            .controlPlaneUnpublished == true and
            .runtimeLeaseReleased == true and
            .dispatchAllowed == false and
            .writeMaster == "disabled" and
            .brokerWriteAttempted == false and
            .secretValuesExposed == false
        ' >/dev/null 2>&1; then
        print -u2 '拒絕生命週期操作：stop completion schema／binding 無效；本次不執行 bootout。'
        return 1
    fi
    if [[ -e "${SMART_ORDER_DISCOVERY_PATH}" || -L "${SMART_ORDER_DISCOVERY_PATH}" ]]; then
        print -u2 '拒絕生命週期操作：stop completion 後 discovery 仍存在；本次不執行 bootout。'
        return 1
    fi
    # launchd may still show the now-closed process until its normal exit.  It
    # is safe to unload only after the exact HMAC completion above proved that
    # the listener, repository, discovery, and exclusive Runtime lease are gone.
    bootout_job "${SMART_ORDER_LABEL}"
    if job_loaded "${SMART_ORDER_LABEL}"; then
        print -u2 '拒絕完成生命週期操作：sidecar job 尚未卸載；handoff barrier 保留，replacement 維持封鎖。'
        return 1
    fi
    completion_binding="$(print -r -- "${result}" | jq -c '.completionBinding')"
    finalized="$(env \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_LIFECYCLE_STOP_BINDING="${completion_binding}" \
        "${NODE_BIN}" "${SMART_ORDER_DIAGNOSTICS}" finalize-stop \
        2>/dev/null)" || {
        print -u2 '生命週期 job 已卸載，但 exact completion 未完成 single-consume；handoff barrier 保留，replacement 維持封鎖。'
        return 1
    }
    if ! print -r -- "${finalized}" | jq -e \
        --arg operation "${operation}" '
            type == "object" and
            .schemaVersion == "smart-order-runtime-stop-finalized/2026-08-12.1" and
            .operation == $operation and
            (.stopRevision | type == "number" and floor == . and . >= 0) and
            .finalized == true and
            .dispatchAllowed == false and
            .writeMaster == "disabled" and
            .brokerWriteAttempted == false and
            .secretValuesExposed == false
        ' >/dev/null 2>&1; then
        print -u2 '生命週期 job 已卸載，但 finalize projection 無效；handoff barrier 保留，replacement 維持封鎖。'
        return 1
    fi
}

assert_smart_order_uninstall_safe() {
    stop_smart_order_sidecar_for_lifecycle uninstall
}

watchdog_environment() {
    env \
        REALTIME_STOCK_REPO_DIR="${REPO_DIR}" \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_WATCHDOG_STATE_DIR="${WATCHDOG_STATE_DIR}" \
        REALTIME_STOCK_MODE_FILE="${MODE_FILE}" \
        REALTIME_STOCK_SIM_SERVICE_TARGET="${LAUNCH_DOMAIN}/${SIM_LABEL}" \
        "${APP_NODE_BIN}" "${WATCHDOG_SCRIPT}" "$1"
}

reset_watchdog() {
    watchdog_environment reset
}

watchdog_status() {
    if [[ -f "${WATCHDOG_SCRIPT}" && -x "${APP_NODE_BIN}" ]]; then
        watchdog_environment status
    else
        print 'business_watchdog_state=unavailable'
        print 'business_watchdog_consecutive_failures=0'
        print 'business_watchdog_restart_count=0'
        print 'business_watchdog_last_reason=unknown'
        print 'business_watchdog_next_eligible_at=0'
    fi
}

watchdog_once() {
    if [[ ! -f "${WATCHDOG_SCRIPT}" || ! -x "${APP_NODE_BIN}" ]]; then
        return 1
    fi
    watchdog_environment once
}

wait_port_free() {
    local port="$1"
    local attempt
    for attempt in {1..15}; do
        if ! lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    print -u2 "port ${port} 尚未釋放"
    return 1
}

wait_api_mode() {
    local expected="$1"
    local attempt actual health_http
    for attempt in {1..30}; do
        actual="$(curl -fsS --max-time 2 http://127.0.0.1:8080/api/v1/info 2>/dev/null | jq -r '.simulation // empty' 2>/dev/null || true)"
        if [[ "${actual}" == "${expected}" ]]; then
            health_http="$(curl -sS --max-time 2 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/api/v1/health 2>/dev/null || true)"
            [[ "${health_http}" == '200' ]] && return 0
        fi
        sleep 1
    done
    return 1
}

wait_web() {
    local attempt
    for attempt in {1..20}; do
        if [[ "$(curl -sS --max-time 2 -o /dev/null -w '%{http_code}' http://127.0.0.1:5173/ 2>/dev/null || true)" == '200' ]]; then
            return 0
        fi
        sleep 1
    done
    return 1
}

wait_multiview() {
    local attempt
    for attempt in {1..30}; do
        if curl -fsS --max-time 2 http://127.0.0.1:5174/api/health 2>/dev/null | jq -e '.ok == true and .runtime == "local-worker" and .persistence.d1 == true' >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

ensure_multiview_job() {
    bootstrap_job "${MULTIVIEW_LABEL}" "${MULTIVIEW_PLIST}"
}

restart_multiview() {
    ensure_runtime_dependencies
    if [[ "$(read_mode)" != 'simulation' ]]; then
        print -u2 'MultiView 本階段只支援 simulation；請先執行 pnpm local-runtime simulation'
        return 1
    fi
    mkdir -p "${INSTALLED_BIN_DIR}"
    install -m 700 "${SCRIPT_PATH}" "${INSTALLED_SCRIPT}"
    [[ -f "${MULTIVIEW_PLIST}" ]] || write_plists
    write_multiview_tdcc_watcher_plist
    bootout_job "${MULTIVIEW_LABEL}"
    wait_port_free 5174
    ensure_multiview_job
    if ! wait_multiview; then
        print -u2 'MultiView 未能在 30 秒內通過獨立健康檢查；5173 與 8080 未受影響'
        return 1
    fi
    bootstrap_job "${MULTIVIEW_TDCC_WATCHER_LABEL}" "${MULTIVIEW_TDCC_WATCHER_PLIST}"
    print 'MultiView 已重新啟動'
}

snapshot_status() {
    local response http_status body
    response="$(curl -sS --max-time 15 -w $'\n%{http_code}' \
        -X POST http://127.0.0.1:8080/api/v1/data/snapshots \
        -H 'Content-Type: application/json' \
        --data '{"contracts":[{"security_type":"STK","region":"TW","exchange":"TSE","code":"2330","target_code":null}]}' || true)"
    http_status="${response##*$'\n'}"
    body="${response%$'\n'*}"

    if [[ "${http_status}" == '200' ]] && print -r -- "${body}" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1; then
        print 'available'
    elif print -r -- "${body}" | grep -q 'SessionNotEstablished'; then
        print 'session-not-established'
    else
        print "unavailable-http-${http_status:-000}"
    fi
}

wait_business_session() {
    local max_attempts="${1:-30}"
    local attempt session_state='unavailable'
    for (( attempt = 1; attempt <= max_attempts; attempt++ )); do
        session_state="$(snapshot_status)"
        if [[ "${session_state}" == 'available' ]]; then
            print 'available'
            return 0
        fi
        sleep 1
    done
    print -r -- "${session_state}"
    return 1
}

run_smart_order_sidecar_start_with_shared_mode_execution_lease() {
    local holder_pid holder_ready=false operation_status=1 holder_status=0
    local status_file error_file completion_file completion_nonce attempt
    preflight_persisted_smart_order_runtime_contract
    if [[ ! -f "${SMART_ORDER_MODE_LEASE_HOLDER}" ||
        -L "${SMART_ORDER_MODE_LEASE_HOLDER}" ]]; then
        print -u2 '拒絕 sidecar-only 啟動：找不到 shared mode execution lease holder'
        return 1
    fi
    status_file="$(mktemp -t realtimestock-shared-mode-lease-status)" || return 1
    error_file="$(mktemp -t realtimestock-shared-mode-lease-error)" || {
        command rm -f "${status_file}"
        return 1
    }
    completion_file="$(mktemp -t realtimestock-shared-mode-lease-completion)" || {
        command rm -f "${status_file}" "${error_file}"
        return 1
    }
    chmod 600 "${status_file}" "${error_file}" "${completion_file}"
    env REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        "${NODE_BIN}" "${SMART_ORDER_MODE_LEASE_HOLDER}" \
        "${APP_SUPPORT}" "$$" "${completion_file}" shared \
        >"${status_file}" 2>"${error_file}" &
    holder_pid=$!
    for attempt in {1..700}; do
        if jq -e '
            type == "object" and
            .schemaVersion == "smart-order-mode-execution-lease-holder/2026-08-20.1" and
            .acquired == true and
            .mode == "shared" and
            (.completionNonce | type == "string" and test("^[0-9a-f-]{36}$")) and
            .brokerAuthority == false
        ' "${status_file}" >/dev/null 2>&1; then
            holder_ready=true
            break
        fi
        if ! kill -0 "${holder_pid}" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if [[ "${holder_ready}" != true ]]; then
        wait "${holder_pid}" 2>/dev/null || true
        print -u2 '拒絕 sidecar-only 啟動：無法取得 shared mode execution lease；未建立 plist 或啟動 job。'
        if [[ -s "${error_file}" ]]; then
            sed -n '1p' "${error_file}" >&2
        fi
        command rm -f "${status_file}" "${error_file}" "${completion_file}"
        return 1
    fi

    if start_smart_order_sidecar_only; then
        operation_status=0
    else
        operation_status=$?
    fi
    completion_nonce="$(jq -er '.completionNonce' "${status_file}")" ||
        operation_status=1
    if [[ -n "${completion_nonce:-}" ]]; then
        print -r -- "${completion_nonce}" > "${completion_file}" ||
            operation_status=1
        chmod 600 "${completion_file}" || operation_status=1
    fi
    kill -TERM "${holder_pid}" 2>/dev/null || true
    wait "${holder_pid}" || holder_status=$?
    command rm -f "${status_file}" "${error_file}" "${completion_file}"
    if (( holder_status != 0 )); then
        print -u2 'sidecar-only 啟動已停止 mutation，但 shared lease holder 未正常結束；結果維持 fail closed。'
        return 1
    fi
    return "${operation_status}"
}

run_with_exclusive_mode_execution_lease() {
    local operation="$1"
    local holder_pid holder_ready=false operation_status=1 holder_status=0
    local status_file error_file completion_file completion_nonce attempt
    case "${operation}" in
        simulation|production-readonly) ;;
        *)
            print -u2 '拒絕 mode switch：exclusive lease operation 不受支援'
            return 2
            ;;
    esac
    preflight_persisted_smart_order_runtime_contract
    if [[ ! -f "${SMART_ORDER_MODE_LEASE_HOLDER}" ]]; then
        print -u2 '拒絕 mode switch：找不到 exclusive mode execution lease holder'
        return 1
    fi
    status_file="$(mktemp -t realtimestock-mode-lease-status)" || return 1
    error_file="$(mktemp -t realtimestock-mode-lease-error)" || {
        command rm -f "${status_file}"
        return 1
    }
    completion_file="$(mktemp -t realtimestock-mode-lease-completion)" || {
        command rm -f "${status_file}" "${error_file}"
        return 1
    }
    chmod 600 "${status_file}" "${error_file}" "${completion_file}"
    env REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        "${NODE_BIN}" "${SMART_ORDER_MODE_LEASE_HOLDER}" \
        "${APP_SUPPORT}" "$$" "${completion_file}" \
        >"${status_file}" 2>"${error_file}" &
    holder_pid=$!
    for attempt in {1..700}; do
        if jq -e '
            type == "object" and
            .schemaVersion == "smart-order-mode-execution-lease-holder/2026-08-20.1" and
            .acquired == true and
            .mode == "exclusive" and
            (.completionNonce | type == "string" and test("^[0-9a-f-]{36}$")) and
            .brokerAuthority == false
        ' "${status_file}" >/dev/null 2>&1; then
            holder_ready=true
            break
        fi
        if ! kill -0 "${holder_pid}" 2>/dev/null; then
            break
        fi
        sleep 0.05
    done
    if [[ "${holder_ready}" != true ]]; then
        wait "${holder_pid}" 2>/dev/null || true
        print -u2 '拒絕 mode switch：無法取得 exclusive mode execution lease；未變更任何服務或 mode marker。'
        if [[ -s "${error_file}" ]]; then
            sed -n '1p' "${error_file}" >&2
        fi
        command rm -f "${status_file}" "${error_file}" "${completion_file}"
        return 1
    fi

    if [[ "${operation}" == 'simulation' ]]; then
        if switch_simulation; then
            operation_status=0
        else
            operation_status=$?
        fi
    else
        if switch_production_readonly; then
            operation_status=0
        else
            operation_status=$?
        fi
    fi

    if (( operation_status == 0 )); then
        completion_nonce="$(jq -er '.completionNonce' "${status_file}")" ||
            operation_status=1
        if (( operation_status == 0 )); then
            print -r -- "${completion_nonce}" > "${completion_file}" ||
                operation_status=1
            chmod 600 "${completion_file}" || operation_status=1
        fi
    fi
    kill -TERM "${holder_pid}" 2>/dev/null || true
    wait "${holder_pid}" || holder_status=$?
    command rm -f "${status_file}" "${error_file}" "${completion_file}"
    if (( holder_status != 0 )); then
        print -u2 'mode switch 已完成安全操作，但 exclusive lease holder 未正常結束；後續切換維持 fail closed。'
        return 1
    fi
    return "${operation_status}"
}

ensure_web_job() {
    bootstrap_job "${WEB_LABEL}" "${WEB_PLIST}"
}

prepare_smart_order_sidecar_for_simulation_return() {
    local mode_state api_generation
    # A completed production-readonly transition has already quiesced, durably
    # stopped, unpublished and finalized the smart-order Runtime.  Its DB root
    # is intentionally retained, so root existence alone cannot require a
    # second authenticated stop after the control plane is gone.  Accept this
    # narrow already-stopped state only while both private mode authorities
    # still prove the same production-readonly incarnation and no unfinished
    # stop handoff exists.  Every other absent／crash state keeps the original
    # fail-closed graceful-stop path.
    if ! job_loaded "${SMART_ORDER_LABEL}" &&
        [[ ! -e "${SMART_ORDER_DISCOVERY_PATH}" &&
        ! -L "${SMART_ORDER_DISCOVERY_PATH}" &&
        ! -e "${SMART_ORDER_LIFECYCLE_STOP_COMPLETION_PATH}" &&
        ! -L "${SMART_ORDER_LIFECYCLE_STOP_COMPLETION_PATH}" &&
        ! -e "${SMART_ORDER_LIFECYCLE_STOP_BARRIER_PATH}" &&
        ! -L "${SMART_ORDER_LIFECYCLE_STOP_BARRIER_PATH}" ]] &&
        mode_state="$(read_private_runtime_mode_contract 2>/dev/null)" &&
        [[ "${mode_state}" == 'production-readonly' ]] &&
        api_generation="$(read_private_api_generation_contract production-readonly 2>/dev/null)" &&
        [[ "${api_generation}" == production-readonly:* ]]; then
        return 0
    fi
    stop_smart_order_sidecar_for_lifecycle graceful_stop
}

switch_simulation() {
    local business_status
    preflight_persisted_smart_order_runtime_contract
    ensure_runtime_dependencies
    [[ -f "${SIM_PLIST}" && -f "${WATCHDOG_PLIST}" && -f "${WEB_PLIST}" && -f "${MULTIVIEW_PLIST}" && -f "${PROD_PLIST}" ]] || write_plists

    prepare_smart_order_sidecar_for_simulation_return
    bootout_job "${WATCHDOG_LABEL}"
    bootout_job "${PROD_LABEL}"
    bootout_job "${SIM_LABEL}"
    wait_port_free 8080
    write_api_generation simulation
    write_mode simulation
    reset_watchdog
    bootstrap_job "${SIM_LABEL}" "${SIM_PLIST}"
    ensure_web_job

    if ! wait_api_mode true; then
        print -u2 'simulation API 未能在 30 秒內完成監聽與模式確認'
        return 1
    fi
    if ! wait_web; then
        print -u2 '本機 Web 未能在 20 秒內啟動'
        return 1
    fi
    if business_status="$(wait_business_session 30)"; then
        print 'simulation 行情 session 已建立'
    else
        print -u2 "simulation HTTP 服務已啟動，但行情 session 尚未建立（${business_status}）；介面維持 OFFLINE，MultiView 使用延遲備援"
    fi

    bootstrap_job "${WATCHDOG_LABEL}" "${WATCHDOG_PLIST}"

    restart_multiview || true
    bootstrap_job "${MULTIVIEW_DAILY_LABEL}" "${MULTIVIEW_DAILY_PLIST}"
    bootstrap_job "${MULTIVIEW_TDCC_LABEL}" "${MULTIVIEW_TDCC_PLIST}"
    bootstrap_job "${MULTIVIEW_TDCC_WATCHER_LABEL}" "${MULTIVIEW_TDCC_WATCHER_PLIST}"
    if smart_order_platform_supported; then
        [[ -f "${SMART_ORDER_PLIST}" ]] || write_smart_order_plist
        start_smart_order_sidecar
    else
        print -u2 'simulation 與一般 RealTimeStock 服務已切換；智慧下單交易 Runtime 在不支援平台維持停止'
    fi

    print '已切換至 simulation'
    runtime_status
}

switch_production_readonly() {
    preflight_persisted_smart_order_runtime_contract
    ensure_runtime_dependencies
    assert_no_ca
    [[ -f "${SIM_PLIST}" && -f "${WATCHDOG_PLIST}" && -f "${WEB_PLIST}" && -f "${PROD_PLIST}" ]] || write_plists

    stop_smart_order_sidecar_for_lifecycle production_readonly
    bootout_job "${WATCHDOG_LABEL}"
    bootout_job "${PROD_LABEL}"
    bootout_job "${SIM_LABEL}"
    bootout_job "${MULTIVIEW_LABEL}"
    bootout_job "${MULTIVIEW_DAILY_LABEL}"
    bootout_job "${MULTIVIEW_TDCC_LABEL}"
    bootout_job "${MULTIVIEW_TDCC_WATCHER_LABEL}"
    wait_port_free 8080
    write_api_generation production-readonly
    write_mode production-readonly
    ensure_web_job
    bootstrap_job "${PROD_LABEL}" "${PROD_PLIST}"

    if ! wait_api_mode false; then
        print -u2 '正式環境 API 未能通過模式與健康檢查，正在回復 simulation'
        switch_simulation
        return 1
    fi
    if ! wait_web; then
        print -u2 '本機 Web 未能在 20 秒內啟動，正在回復 simulation'
        switch_simulation
        return 1
    fi

    local market_status
    market_status="$(snapshot_status)"
    if [[ "${market_status}" != 'available' ]]; then
        print -u2 "正式行情不可用（${market_status}），正在回復 simulation"
        switch_simulation
        return 1
    fi

    print '已切換至 production-readonly；交易寫入由本機 Web guard 封鎖，且未載入 CA'
    runtime_status
}

runtime_status() {
    local info simulation health market web_http multiview_http multiview_health state_status
    print "runtime_mode=$(read_mode)"
    print "simulation_job=$(job_loaded "${SIM_LABEL}" && print loaded || print stopped)"
    print "business_watchdog_job=$(job_loaded "${WATCHDOG_LABEL}" && print loaded || print stopped)"
    print "production_readonly_job=$(job_loaded "${PROD_LABEL}" && print loaded || print stopped)"
    print "web_job=$(job_loaded "${WEB_LABEL}" && print loaded || print stopped)"
    smart_order_sidecar_status
    print "multiview_job=$(job_loaded "${MULTIVIEW_LABEL}" && print loaded || print stopped)"
    print "multiview_daily_pipeline_job=$(job_loaded "${MULTIVIEW_DAILY_LABEL}" && print loaded || print stopped)"
    print "multiview_tdcc_pipeline_job=$(job_loaded "${MULTIVIEW_TDCC_LABEL}" && print loaded || print stopped)"
    print "multiview_tdcc_watcher_job=$(job_loaded "${MULTIVIEW_TDCC_WATCHER_LABEL}" && print loaded || print stopped)"
    watchdog_status

    info="$(curl -fsS --max-time 3 http://127.0.0.1:8080/api/v1/info 2>/dev/null || true)"
    if [[ -n "${info}" ]]; then
        simulation="$(print -r -- "${info}" | jq -r '.simulation // "unknown"')"
        health="$(curl -fsS --max-time 3 http://127.0.0.1:8080/api/v1/health 2>/dev/null | jq -r '.status // "unknown"' 2>/dev/null || print unavailable)"
        market="$(snapshot_status)"
        print "api_listener=up"
        print "api_simulation=${simulation}"
        print "api_health=${health}"
        print "api_business_session=${market}"
        print "market_snapshot_2330=${market}"
    else
        print 'api_listener=down'
    fi

    web_http="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:5173/ 2>/dev/null || true)"
    if [[ "${web_http}" == '200' ]]; then
        print 'web_listener=up'
    else
        print 'web_listener=down'
    fi

    multiview_http="$(curl -sS --max-time 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:5174/api/health 2>/dev/null || true)"
    if [[ "${multiview_http}" == '200' ]]; then
        multiview_health="$(curl -fsS --max-time 3 http://127.0.0.1:5174/api/health 2>/dev/null || true)"
        print 'multiview_listener=up'
        print "multiview_d1=$(print -r -- "${multiview_health}" | jq -r '.persistence.d1 // false')"
        print "multiview_schema_revision=$(print -r -- "${multiview_health}" | jq -r '.persistence.schemaRevision // "unknown"')"
        print "multiview_realtime_source=$(print -r -- "${multiview_health}" | jq -r '.shioajiAdapter.configured // false')"
    else
        print 'multiview_listener=down'
    fi
    state_status="$(MULTIVIEW_STATE_DIR="${MULTIVIEW_STATE_DIR}" "${MULTIVIEW_STATE_SCRIPT}" status 2>/dev/null || true)"
    print "multiview_d1_integrity=$(print -r -- "${state_status}" | awk -F= '$1 == "integrity" {print $2}')"
    print "multiview_d1_coverage=$(print -r -- "${state_status}" | awk -F= '$1 == "schema_coverage" {print $2}')"
    print "multiview_after_hours_source=$(print -r -- "${state_status}" | awk -F= '$1 == "after_hours_source" {print $2}')"
    local after_hours_all='completed'
    local after_hours_group after_hours_value
    for after_hours_group in market chip tdcc pe; do
        after_hours_value="$(print -r -- "${state_status}" | awk -F= -v key="after_hours_${after_hours_group}" '$1 == key {print $2}')"
        [[ -n "${after_hours_value}" ]] || after_hours_value='unknown'
        print "multiview_after_hours_${after_hours_group}=${after_hours_value}"
        [[ "${after_hours_value}" == 'completed' ]] || after_hours_all='incomplete'
    done
    print "multiview_after_hours=${after_hours_all}"
}

install_runtime() {
    local business_status
    persist_node_runtime_contract
    preflight_persisted_smart_order_runtime_contract
    ensure_runtime_dependencies
    mkdir -p "${INSTALLED_BIN_DIR}"
    install -m 700 "${SCRIPT_PATH}" "${INSTALLED_SCRIPT}"
    write_plists
    stop_smart_order_sidecar_for_lifecycle graceful_stop
    bootout_job "${PROD_LABEL}"
    bootout_job "${WATCHDOG_LABEL}"
    bootout_job "${SIM_LABEL}"
    bootout_job "${WEB_LABEL}"
    bootout_job "${MULTIVIEW_LABEL}"
    bootout_job "${MULTIVIEW_DAILY_LABEL}"
    bootout_job "${MULTIVIEW_TDCC_LABEL}"
    bootout_job "${MULTIVIEW_TDCC_WATCHER_LABEL}"
    wait_port_free 8080
    wait_port_free 5173
    wait_port_free 5174
    MULTIVIEW_STATE_DIR="${MULTIVIEW_STATE_DIR}" "${MULTIVIEW_STATE_SCRIPT}" migrate
    ensure_multiview_pipeline_secret
    write_api_generation simulation
    write_mode simulation
    reset_watchdog
    bootstrap_job "${SIM_LABEL}" "${SIM_PLIST}"
    bootstrap_job "${WEB_LABEL}" "${WEB_PLIST}"

    if ! wait_api_mode true; then
        print -u2 '安裝完成，但 simulation API 尚未完成監聽與模式確認'
        return 1
    fi
    if ! wait_web; then
        print -u2 '安裝完成，但本機 Web 尚未通過健康檢查'
        return 1
    fi
    if business_status="$(wait_business_session 30)"; then
        print 'simulation 行情 session 已建立'
    else
        print -u2 "simulation HTTP 服務已啟動，但行情 session 尚未建立（${business_status}）；介面維持 OFFLINE，MultiView 使用延遲備援"
    fi

    bootstrap_job "${WATCHDOG_LABEL}" "${WATCHDOG_PLIST}"

    bootstrap_job "${MULTIVIEW_LABEL}" "${MULTIVIEW_PLIST}"
    bootstrap_job "${MULTIVIEW_DAILY_LABEL}" "${MULTIVIEW_DAILY_PLIST}"
    bootstrap_job "${MULTIVIEW_TDCC_LABEL}" "${MULTIVIEW_TDCC_PLIST}"
    bootstrap_job "${MULTIVIEW_TDCC_WATCHER_LABEL}" "${MULTIVIEW_TDCC_WATCHER_PLIST}"

    if ! wait_multiview; then
        print -u2 '安裝完成，但 MultiView 尚未通過健康檢查；simulation API 與本機 Web 維持執行'
        return 1
    fi
    if smart_order_platform_supported; then
        [[ -f "${SMART_ORDER_PLIST}" ]] || write_smart_order_plist
        start_smart_order_sidecar
    else
        print -u2 '一般 RealTimeStock LaunchAgent 已安裝；智慧下單交易 Runtime 在不支援平台維持停止'
    fi
    print 'LaunchAgent 已安裝；登入後預設只會自動啟動 simulation'
    runtime_status
}

uninstall_runtime() {
    assert_smart_order_uninstall_safe
    bootout_job "${PROD_LABEL}"
    bootout_job "${WATCHDOG_LABEL}"
    bootout_job "${SIM_LABEL}"
    bootout_job "${WEB_LABEL}"
    bootout_job "${MULTIVIEW_LABEL}"
    bootout_job "${MULTIVIEW_DAILY_LABEL}"
    bootout_job "${MULTIVIEW_TDCC_LABEL}"
    bootout_job "${MULTIVIEW_TDCC_WATCHER_LABEL}"
    bootout_job "${SMART_ORDER_LABEL}"
    command rm -f "${SIM_PLIST}" "${WATCHDOG_PLIST}" "${WEB_PLIST}" "${SMART_ORDER_PLIST}" "${MULTIVIEW_PLIST}" "${MULTIVIEW_DAILY_PLIST}" "${MULTIVIEW_TDCC_PLIST}" "${MULTIVIEW_TDCC_WATCHER_PLIST}" "${PROD_PLIST}"
    command rm -f "${WATCHDOG_STATE_DIR}/state.json" "${WATCHDOG_STATE_DIR}/watchdog-once.lock"
    command rmdir "${WATCHDOG_STATE_DIR}" 2>/dev/null || true
    command rm -f "${INSTALLED_SCRIPT}"
    command rm -f "${SMART_ORDER_CAPABILITY_PATH}"
    write_mode simulation
    print "已移除 RealTimeStock LaunchAgent 與未使用的智慧下單 gateway capability；.env、MultiView D1、智慧下單 DB／WAL／backup／strategy／audit 與設定仍保留"
}

service_api_simulation() {
    preflight_persisted_smart_order_runtime_contract
    ensure_runtime_dependencies
    # The marker identifies this exact API process incarnation.  KeepAlive,
    # watchdog kickstart, and manual service restarts must all retire the old
    # smart-order fence before the API opens a listener.
    write_api_generation simulation
    write_mode simulation
    cd "${REPO_DIR}"
    unset SJ_CA_PATH SJ_CA_PASSWD
    exec env \
        SJ_PRODUCTION=false \
        SJ_HTTP_ADDR=127.0.0.1:8080 \
        "${SHIOAJI_BIN}" server start --no-open
}

service_api_production_readonly() {
    preflight_persisted_smart_order_runtime_contract
    ensure_runtime_dependencies
    assert_no_ca
    write_api_generation production-readonly
    write_mode production-readonly
    cd "${REPO_DIR}"
    unset SJ_CA_PATH SJ_CA_PASSWD
    exec env \
        SJ_PRODUCTION=true \
        SJ_HTTP_ADDR=127.0.0.1:8080 \
        "${SHIOAJI_BIN}" server start --production --no-open
}

service_web() {
    ensure_runtime_dependencies
    cd "${REPO_DIR}"
    exec env \
        VITE_API_TARGET=http://127.0.0.1:8080 \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_MODE_FILE="${MODE_FILE}" \
        "${APP_NODE_BIN}" "${VITE_BIN}" --host 127.0.0.1 --strictPort
}

service_smart_order_sidecar() {
    local persisted_node mode_state
    preflight_persisted_smart_order_runtime_contract
    if ! smart_order_platform_supported; then
        print -u2 '智慧下單 sidecar 拒絕啟動：僅支援原生 Apple Silicon arm64 macOS；未取得 broker authority'
        return 1
    fi
    persisted_node="${NODE_BIN}"
    if ! mode_state="$(read_private_runtime_mode_contract)" ||
        [[ "${mode_state}" != 'simulation' ]] ||
        ! read_private_api_generation_contract simulation >/dev/null; then
        print -u2 '智慧下單 sidecar 拒絕啟動：目前不是 simulation'
        return 1
    fi
    if [[ ! -f "${SMART_ORDER_ENTRY}" ]]; then
        print -u2 '智慧下單 sidecar entry 不存在；保持 fail closed'
        return 1
    fi
    cd "${REPO_DIR}"
    exec env \
        REALTIME_STOCK_APP_SUPPORT="${APP_SUPPORT}" \
        "${persisted_node}" "${SMART_ORDER_ENTRY}"
}

probe_smart_order_node_sqlite() {
    preflight_persisted_smart_order_runtime_contract
    if ! smart_order_platform_supported; then
        print -u2 'Node SQLite capability probe僅接受原生Apple Silicon arm64實機'
        return 1
    fi
    if [[ ! -f "${SMART_ORDER_NODE_SQLITE_PROBE}" ||
        -L "${SMART_ORDER_NODE_SQLITE_PROBE}" ]]; then
        print -u2 'Node SQLite capability probe不存在或不是實體source file'
        return 1
    fi
    cd "${REPO_DIR}"
    exec env -i \
        PATH='/usr/bin:/bin:/usr/sbin:/sbin' \
        LANG='C' \
        LC_ALL='C' \
        REALTIME_STOCK_NODE_SQLITE_APP_SUPPORT="${APP_SUPPORT}" \
        REALTIME_STOCK_NODE_SQLITE_LAUNCHAGENT_PLIST="${SMART_ORDER_PLIST}" \
        REALTIME_STOCK_NODE_SQLITE_INSTALLED_RUNTIME="${INSTALLED_SCRIPT}" \
        "${NODE_BIN}" "${SMART_ORDER_NODE_SQLITE_PROBE}"
}

run_smart_order_node_sqlite_admin() {
    local admin_command="$1"
    shift
    preflight_persisted_smart_order_runtime_contract
    if ! smart_order_platform_supported; then
        print -u2 'Node SQLite capability admin僅接受原生Apple Silicon arm64實機'
        return 1
    fi
    if [[ ! -f "${SMART_ORDER_NODE_SQLITE_ADMIN}" ||
        -L "${SMART_ORDER_NODE_SQLITE_ADMIN}" ]]; then
        print -u2 'Node SQLite capability admin不存在或不是實體source file'
        return 1
    fi
    cd "${REPO_DIR}"
    exec env -i \
        PATH='/usr/bin:/bin:/usr/sbin:/sbin' \
        LANG='C' \
        LC_ALL='C' \
        REALTIME_STOCK_NODE_SQLITE_APP_SUPPORT="${APP_SUPPORT}" \
        "${NODE_BIN}" "${SMART_ORDER_NODE_SQLITE_ADMIN}" \
        "${admin_command}" "$@"
}

service_multiview() {
    ensure_runtime_dependencies
    if [[ "$(read_mode)" != 'simulation' ]]; then
        print -u2 'MultiView 本階段只支援 simulation，非 simulation 模式不啟動 5174'
        return 1
    fi
    local pipeline_secret
    pipeline_secret="$(read_multiview_pipeline_secret)"
    cd "${REPO_DIR}/apps/multiview"
    exec env \
        MULTIVIEW_STATE_DIR="${MULTIVIEW_STATE_DIR}" \
        WRANGLER_WRITE_LOGS=false \
        WRANGLER_LOG_PATH="${MULTIVIEW_STATE_DIR}/logs/wrangler.log" \
        MINIFLARE_REGISTRY_PATH="${MULTIVIEW_STATE_DIR}/registry" \
        MULTIVIEW_LOCAL_PIPELINE_SECRET="${pipeline_secret}" \
        "${APP_NODE_BIN}" "${MULTIVIEW_CLI}" dev --hostname 127.0.0.1 --port 5174
}

service_multiview_daily_pipeline() {
    local pipeline_secret scheduled_time
    pipeline_secret="$(read_multiview_pipeline_secret)"
    wait_multiview
    scheduled_time="$(($(date +%s) * 1000))"
    curl -fsS --max-time 180 -X POST http://127.0.0.1:5174/api/internal/local-maintenance \
        -H 'Content-Type: application/json' \
        -H "X-MultiView-Local-Authorization: Bearer ${pipeline_secret}" \
        --data "{\"action\":\"daily\",\"scheduledTime\":${scheduled_time}}" | jq -e '.ok == true' >/dev/null
    cd "${REPO_DIR}/apps/multiview"
    env PE_RIVER_BACKFILL_SECRET="${pipeline_secret}" PE_RIVER_INGEST_SECRET="${pipeline_secret}" \
        "${APP_NODE_BIN}" scripts/pe-river-continuous-backfill.mjs \
        --site-url=http://127.0.0.1:5174 --trigger=schedule --run-id="local-pe-$(date +%Y%m%d-%H)"
    service_multiview_screener_pipeline
}

service_multiview_tdcc_pipeline() {
    local pipeline_secret checkpoint_dir
    pipeline_secret="$(read_multiview_pipeline_secret)"
    checkpoint_dir="${MULTIVIEW_STATE_DIR}/checkpoints/tdcc"
    mkdir -p "${checkpoint_dir}"
    chmod 700 "${checkpoint_dir}"
    wait_multiview
    cd "${REPO_DIR}/apps/multiview"
    env TDCC_CONTINUOUS_BACKFILL_SECRET="${pipeline_secret}" TDCC_HISTORY_INGEST_SECRET="${pipeline_secret}" \
        "${APP_NODE_BIN}" scripts/tdcc-history-backfill.mjs --continuous \
        --site-url=http://127.0.0.1:5174 --trigger=schedule --run-id="local-tdcc-$(date +%Y%m%d)" \
        --checkpoint="${checkpoint_dir}/continuous.json" --claim-limit=2 --max-run-ms=1200000
    service_multiview_screener_pipeline
}

# Runs after existing maintenance, and remains disabled until verified bootstrap enables it.
# This does not install/restart any service or activate TDCC historical backfill.
service_multiview_screener_pipeline() {
    local screener_database
    local -a screener_databases
    screener_databases=("${(@f)$(find "${MULTIVIEW_STATE_DIR}/state/v3/d1" -type f -name '*.sqlite' ! -name 'metadata.sqlite' -print)}")
    if (( ${#screener_databases} != 1 )); then
        print -u2 '選股更新未執行：本機資料庫目標不唯一'
        return 0
    fi
    screener_database="${screener_databases[1]}"
    [[ -f "${screener_database}" ]] || return 0
    "${NODE_BIN}" "${REPO_DIR}/scripts/stock-screener-update.mjs" \
        --database="${screener_database}" --scheduled \
        || print -u2 '選股資料更新暫未就緒；既有維護工作不受影響'
}

service_multiview_tdcc_watcher() {
    local pipeline_secret probe lock_dir run_id exit_code
    pipeline_secret="$(read_multiview_pipeline_secret)"
    wait_multiview
    probe="$(curl -fsS --max-time 30 -X POST http://127.0.0.1:5174/api/internal/tdcc-continuous-backfill \
        -H 'Content-Type: application/json' \
        -H "Authorization: Bearer ${pipeline_secret}" \
        --data '{"action":"queue-probe"}')"
    print -r -- "${probe}" | jq -e '.ok == true and (.queue.shouldRun | type == "boolean")' >/dev/null
    if [[ "$(print -r -- "${probe}" | jq -r '.queue.shouldRun')" != 'true' ]]; then
        print '{"event":"tdcc-watcher-noop","reason":"queue_empty"}'
        service_multiview_screener_pipeline
        return 0
    fi
    lock_dir="${MULTIVIEW_STATE_DIR}/locks/tdcc-watcher"
    mkdir -p "${MULTIVIEW_STATE_DIR}/locks"
    chmod 700 "${MULTIVIEW_STATE_DIR}/locks"
    if ! mkdir "${lock_dir}" 2>/dev/null; then
        print '{"event":"tdcc-watcher-noop","reason":"single_flight_active"}'
        return 0
    fi
    run_id="local-tdcc-watch-$(date +%Y%m%d-%H%M)"
    exit_code=0
    cd "${REPO_DIR}/apps/multiview"
    env TDCC_CONTINUOUS_BACKFILL_SECRET="${pipeline_secret}" TDCC_HISTORY_INGEST_SECRET="${pipeline_secret}" \
        "${APP_NODE_BIN}" scripts/tdcc-history-backfill.mjs --continuous --history-only \
        --site-url=http://127.0.0.1:5174 --trigger=schedule --run-id="${run_id}" \
        --checkpoint="${MULTIVIEW_STATE_DIR}/checkpoints/tdcc/continuous.json" --claim-limit=2 --max-run-ms=1200000 || exit_code=$?
    command rmdir "${lock_dir}" 2>/dev/null || true
    if (( exit_code == 0 )); then service_multiview_screener_pipeline; fi
    return "${exit_code}"
}

command_name="${1:-}"
case "${command_name}" in
    install) install_runtime ;;
    uninstall) uninstall_runtime ;;
    simulation) run_with_exclusive_mode_execution_lease simulation ;;
    production-readonly) run_with_exclusive_mode_execution_lease production-readonly ;;
    restart) restart_multiview ;;
    multiview-daily) service_multiview_daily_pipeline ;;
    multiview-tdcc) service_multiview_tdcc_pipeline ;;
    multiview-tdcc-watcher) service_multiview_tdcc_watcher ;;
    status) runtime_status ;;
    node-sqlite-probe) probe_smart_order_node_sqlite ;;
    node-sqlite-host-public)
        run_smart_order_node_sqlite_admin host-public ;;
    node-sqlite-trust-host)
        run_smart_order_node_sqlite_admin trust-host "${2:-}" "${3:-}" ;;
    node-sqlite-import-report)
        run_smart_order_node_sqlite_admin import-report "${2:-}" "${3:-}" ;;
    smart-order-start) run_smart_order_sidecar_start_with_shared_mode_execution_lease ;;
    smart-order-task0-3c-stop) stop_smart_order_sidecar_for_lifecycle graceful_stop ;;
    gate-probe-prepare)
        run_smart_order_gate_probe_prepare "${2:-}" ;;
    task0-3b-probe)
        shift
        run_smart_order_task0_3b_probe "$@" ;;
    task0-3c-external-sell)
        shift
        run_smart_order_task0_3c_external_sell "$@" ;;
    task0-3c-authorization-preview)
        shift
        run_smart_order_task0_3c_authorization_preview "$@" ;;
    task0-3c-preflight)
        run_smart_order_task0_3c_preflight ;;
    task0-3c-finalize)
        shift
        run_smart_order_task0_3c_finalize "$@" ;;
    task0-3c-gate-recompute)
        run_smart_order_task0_3c_gate_recompute ;;
    task0-3b-reconcile-update)
        run_smart_order_task0_3b_update_reconcile ;;
    task0-3b-verify-update)
        run_smart_order_task0_3b_update_reconcile verify-only ;;
    task0-4-0-6-probe)
        shift
        run_smart_order_task0_4_0_6_probe "$@" ;;
    task13-2-evidence)
        run_smart_order_task13_2_evidence ;;
    strategy-cancel|cancel-broker-order|drain-prepared|relinquish-protection-prepare|relinquish-protection-commit)
        run_smart_order_typed_drain_action "${command_name}" "${2:-}" "${3:-}" "${4:-}" ;;
    watchdog-once) watchdog_once ;;
    watchdog-reset) reset_watchdog ;;
    service-api-simulation) service_api_simulation ;;
    service-api-production-readonly) service_api_production_readonly ;;
    service-web) service_web ;;
    service-smart-order-sidecar) service_smart_order_sidecar ;;
    service-multiview) service_multiview ;;
    service-multiview-daily-pipeline) service_multiview_daily_pipeline ;;
    service-multiview-tdcc-pipeline) service_multiview_tdcc_pipeline ;;
    service-multiview-tdcc-watcher) service_multiview_tdcc_watcher ;;
    *) usage; exit 2 ;;
esac
